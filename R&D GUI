#!/usr/bin/env python3
"""
gui_app.py  ─ 실험자용 GUI
===========================
튜닝 패널, 실시간 주파수 그래프, 자동 라벨 저장(실측 채움률은 선택 입력)을 포함한
연구/개발 환경 전용 GUI.

[v5.33] 급수 종료 시 자동 라벨(유량 × 밸브 열린 시간 ÷ 기준 용적)로 즉시 저장한다.
        기준 용적 = '실측용적(mL)' 입력값(cup_info.csv에 저장) → 없으면 주파수 추정 용적.

main.py 에서 --mode lab 선택 시 실행된다.
"""
import time, threading
import customtkinter as ctk
from PIL import Image
from matplotlib.figure import Figure
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg
import smart_water_core as core
from csv_logger import save_to_csv
import experiment_recorder as exp_rec


def run_kiosk_gui(on_ready=None):
    ctk.set_appearance_mode('light')
    ctk.set_default_color_theme('blue')
    C_BG         = '#F6F7FB'
    C_CARD       = '#FFFFFF'
    C_NAVY       = '#0B2D5B'
    C_NAVY_HOVER = '#123A73'
    C_TEXT       = '#0F172A'
    C_MUTED      = '#64748B'
    C_GREEN      = '#0B7A3E'                                        # 음성 수위 표시색

    app = ctk.CTk()
    app.title('주파수 기반 급수 제어 시스템')
    app.configure(fg_color=C_BG)

    ctk.set_widget_scaling(0.67)
    ctk.set_window_scaling(0.67)

    app.geometry('1280x650+0+0')
    app.minsize(720, 360)

    status_var      = ctk.StringVar(value='GPIO 제어 모드 준비됨')
    d_var           = ctk.StringVar(value='지름(D) : - cm')
    f_var           = ctk.StringVar(value='주파수(F) : - Hz')
    tf_var          = ctk.StringVar(value='목표(Target) : - %')
    air_var         = ctk.StringVar(value='수위(Level) : - %')
    vol_var         = ctk.StringVar(value='급수량(Q·t) : - mL')            # [v5.33] 밸브 열린 시간 기반 급수량
    init_air_var    = ctk.StringVar(value='초기 공기층(용기 높이) : - cm')
    hit_var         = ctk.StringVar(value=f'확신(Hits) : 0/{core.STOP_TRIGGER_COUNT}')
    voice_level_var = ctk.StringVar(value='🎤 음성 목표 수위 : - %')  # 음성 설정 수위 표시
    trial_var       = ctk.StringVar(value='Trial : 대기')

    def set_status(s: str):
        status_var.set(s)
        print(f'\n[GUI] {s}')

    def _optional_float(entry):
        text = entry.get().strip()
        if not text:
            return None
        try:
            return float(text)
        except ValueError:
            return None

    _pending_save = [None]

    def gui_on():
        with core.lock:
            if core.is_filling:
                return

        # 이전 실험이 아직 저장되지 않았으면 다음 Trial 시작 금지 (v5.33부터는 종료 시 자동 저장)
        rec_status = exp_rec.get_status()
        if rec_status.get('pending'):
            set_status(f"{rec_status.get('pending_trial')} 저장 후 다음 실험을 시작하세요.")
            return

        line_freq.set_data([], [])
        line_detected.set_data([], [])
        line_stop.set_data([], [])
        line_ctrl.set_data([], [])
        ax.set_xlim(0, 1)
        ax.set_ylim(core.FREQ_MIN_LIMIT, core.FREQ_MAX_LIMIT)
        target_line.set_alpha(0.0)
        canvas.draw_idle()

        d_var.set('지름(D) : - cm')
        f_var.set('주파수(F) : - Hz')
        tf_var.set('목표(Target) : - %')
        air_var.set('수위(Level) : - %')
        vol_var.set('급수량(Q·t) : - mL')
        init_air_var.set('초기 공기층(용기 높이) : - cm')
        hit_var.set(f'확신(Hits) : 0/{core.STOP_TRIGGER_COUNT}')
        progress.set(0.0)

        _pending_save[0] = None
        try:
            actual_air_frame.pack_forget()
            actual_air_entry.delete(0, 'end')
        except Exception:
            pass

        cup_name = cup_name_entry.get().strip() or 'unknown'
        cup_h = _optional_float(cup_height_entry)
        cup_top_d = _optional_float(cup_top_d_entry)
        cup_bottom_d = _optional_float(cup_bottom_d_entry)
        cup_vol = _optional_float(cup_volume_entry)                    # [v5.33] 실측 컵 용적(mL), 선택

        core.ensure_audio_stream()
        core.start_filling_local()

        try:
            trial_id = exp_rec.start_trial(
                core,
                cup_name=cup_name,
                cup_height_cm=cup_h,
                cup_top_diameter_cm=cup_top_d,
                cup_bottom_diameter_cm=cup_bottom_d,
                cup_volume_ml=cup_vol,
                code_version='v5.33-vol-round-label+exp-rec',
                sample_interval_sec=0.20,
            )
            trial_var.set(f'Trial : {trial_id}')
        except Exception as e:
            core.solenoid_off()
            core.stop_filling_local(save_result=False)
            set_status(f'실험 기록 시작 실패: {e}')
            return

        set_status(f'{trial_id} → 배경 소음 측정 중...')

        def delayed_pump_on():
            time.sleep(core.NOISE_CALIBRATION_TIME + 0.1)
            with core.lock:
                still = bool(core.is_filling)
            if still:
                core.solenoid_on()
                print('\n>>> [2단계] 소음 측정 완료. 펌프 가동!')

        threading.Thread(target=delayed_pump_on, daemon=True).start()

    def gui_off():
        core.solenoid_off()
        core.stop_filling_local(save_result=True)
        set_status('GUI OFF → 주입 종료')

    def on_close():
        _pending_save[0] = None
        exp_rec.abort_trial()
        core.solenoid_off()
        try:
            import voice_module as vm
            vm._shutdown.set()          # 음성인식 루프 종료 신호
            vm.stop_dispenser_sound()   # 재생 중인 음원도 정지
        except Exception:
            pass
        try:
            if core.audio_stream:
                core.audio_stream.stop()
                core.audio_stream.close()
        except Exception:
            pass
        try:
            core.sw_on.close()
            core.sw_off.close()
            core.solenoid.close()
        except Exception:
            pass
        app.destroy()

    container = ctk.CTkFrame(app, fg_color=C_BG, corner_radius=0)
    container.pack(fill='both', expand=True, padx=20, pady=20)

    card = ctk.CTkFrame(container, fg_color=C_CARD, corner_radius=20)
    card.pack(fill='both', expand=True)
    card.grid_rowconfigure(0, weight=0)
    card.grid_rowconfigure(1, weight=1)
    card.grid_rowconfigure(2, weight=0)
    card.grid_columnconfigure(0, weight=1)

    header = ctk.CTkFrame(card, fg_color=C_CARD, corner_radius=20)
    header.grid(row=0, column=0, sticky='ew', padx=24, pady=(24, 10))
    header.grid_columnconfigure(0, weight=1)

    ctk.CTkLabel(header, text='주파수 기반 급수 제어 시스템',
                 text_color=C_NAVY,
                 font=ctk.CTkFont(family='Malgun Gothic', size=28, weight='bold')
                 ).grid(row=0, column=0, sticky='w')

    ctk.CTkLabel(header,
                 text=f'LPC+LOESS+LSM v9 | SOL:{core.SOLENOID_GPIO} / ON:{core.SW_ON_GPIO} / OFF:{core.SW_OFF_GPIO}',
                 text_color=C_MUTED,
                 font=ctk.CTkFont(family='Malgun Gothic', size=13)
                 ).grid(row=1, column=0, sticky='w', pady=(6, 0))

    try:
        pil_img  = Image.open(core.LOGO_PATH)
        logo_img = ctk.CTkImage(light_image=pil_img, size=core.LOGO_SIZE)
        ctk.CTkLabel(header, text='', image=logo_img, fg_color='transparent').place(relx=1.0, rely=0.0, anchor='ne')
    except Exception:
        pass

    body = ctk.CTkFrame(card, fg_color=C_CARD, corner_radius=16)
    body.grid(row=1, column=0, sticky='nsew', padx=24, pady=(0, 10))
    body.grid_rowconfigure(0, weight=1)
    body.grid_columnconfigure(0, weight=1)
    body.grid_columnconfigure(1, weight=1)

    left  = ctk.CTkFrame(body, fg_color=C_CARD, corner_radius=16)
    left.grid(row=0, column=0, sticky='nsew', padx=(0, 12))
    right = ctk.CTkFrame(body, fg_color=C_CARD, corner_radius=16)
    right.grid(row=0, column=1, sticky='nsew', padx=(12, 0))

    gpio_info = ctk.CTkFrame(left, fg_color=C_CARD, corner_radius=16)
    gpio_info.pack(fill='x', pady=(0, 12))
    gpio_info.grid_columnconfigure(1, weight=1)

    for row_i, (label, val) in enumerate([
        ('제어 방식',   'Raspberry Pi Direct'),
        ('솔레노이드', f'BCM {core.SOLENOID_GPIO}'),
        ('ON 스위치',  f'BCM {core.SW_ON_GPIO}'),
        ('OFF 스위치', f'BCM {core.SW_OFF_GPIO}'),
        ('TRIGGER',    'HIGH' if core.RELAY_ACTIVE_HIGH else 'LOW'),
    ]):
        ctk.CTkLabel(gpio_info, text=label, text_color=C_TEXT,
                     font=('Malgun Gothic', 14, 'bold')
                     ).grid(row=row_i, column=0, sticky='w', padx=(0, 12),
                            pady=(0, 8) if row_i == 0 else (8, 0))
        ctk.CTkLabel(gpio_info, text=val, text_color=C_MUTED,
                     font=('Malgun Gothic', 14)
                     ).grid(row=row_i, column=1, sticky='w',
                            pady=(0, 8) if row_i == 0 else (8, 0))

    btn_area = ctk.CTkFrame(left, fg_color=C_CARD, corner_radius=16)
    btn_area.pack(fill='x', pady=(0, 12))

    ctk.CTkButton(btn_area, text='ON  (주입 시작)', height=64,
                  fg_color=C_NAVY, hover_color=C_NAVY_HOVER,
                  font=('Malgun Gothic', 20, 'bold'), corner_radius=18,
                  command=gui_on).pack(fill='x', pady=(0, 10))

    ctk.CTkButton(btn_area, text='OFF (주입 종료)', height=64,
                  fg_color=C_CARD, hover_color='#F1F5F9',
                  border_color='#CBD5E1', border_width=2,
                  text_color=C_TEXT, font=('Malgun Gothic', 20, 'bold'),
                  corner_radius=18, command=gui_off).pack(fill='x')

    tune = ctk.CTkFrame(left, fg_color=C_CARD, corner_radius=16)
    tune.pack(fill='both', expand=True)
    tune.grid_columnconfigure(0, weight=1)

    ctk.CTkLabel(tune, text='튜닝 패널', text_color=C_TEXT,
                 font=('Malgun Gothic', 16, 'bold')
                 ).grid(row=0, column=0, sticky='w', padx=12, pady=(12, 6))

    DEFAULT_STOP  = int(core.STOP_TRIGGER_COUNT)
    DEFAULT_CTRL  = float(core.CONTROL_START_TIME)
    DEFAULT_AIR   = float(core.TARGET_FILL_PCT)
    DEFAULT_FMAX  = int(core.FREQ_MAX_LIMIT)
    DEFAULT_ECEIL = int(core.EARLY_CEIL_HZ)

    lock_var       = ctk.BooleanVar(value=True)
    stop_cnt_var   = ctk.IntVar(value=DEFAULT_STOP)
    ctrl_start_var = ctk.DoubleVar(value=DEFAULT_CTRL)
    target_air_var = ctk.DoubleVar(value=DEFAULT_AIR)
    fmax_var       = ctk.IntVar(value=DEFAULT_FMAX)
    early_ceil_var = ctk.IntVar(value=DEFAULT_ECEIL)
    lock_hint      = ctk.StringVar(value='LOCK 상태: 변경 불가')

    def apply_tuning():
        if lock_var.get():
            return
        core.STOP_TRIGGER_COUNT = int(stop_cnt_var.get())
        core.CONTROL_START_TIME = float(ctrl_start_var.get())
        core.FREQ_MAX_LIMIT     = int(fmax_var.get())
        core.EARLY_CEIL_HZ      = int(early_ceil_var.get())

        # [PCT] TARGET_FILL_PCT 직접 설정 → _eff_target_air_cm 재계산
        core.TARGET_FILL_PCT = float(target_air_var.get())
        with core.lock:
            init_air = float(core.init_air_len_cm)
            if init_air > 0:
                core._eff_target_air_cm = max(0.5, init_air * (1.0 - core.TARGET_FILL_PCT / 100.0))
            if core.calibration_done and core.current_diameter > 0 and core._eff_target_air_cm > 0:
                core.target_freq = float(
                    core.SOUND_SPEED / (4 * (core._eff_target_air_cm + core.END_CORRECTION_K * core.current_diameter))
                )

    def on_lock_toggle():
        locked = lock_var.get()
        lock_hint.set('LOCK 상태: 변경 불가' if locked else 'UNLOCK 상태: 변경 가능')
        st = 'disabled' if locked else 'normal'
        for sl in [stop_cnt_sl, ctrl_start_sl, target_air_sl, early_ceil_sl, fmax_sl]:
            sl.configure(state=st)

    def reset_defaults():
        for var, val in [
            (stop_cnt_var,   DEFAULT_STOP),
            (ctrl_start_var, DEFAULT_CTRL),
            (target_air_var, DEFAULT_AIR),
            (fmax_var,       DEFAULT_FMAX),
            (early_ceil_var, DEFAULT_ECEIL),
        ]:
            var.set(val)

        core.STOP_TRIGGER_COUNT = DEFAULT_STOP
        core.CONTROL_START_TIME = DEFAULT_CTRL
        core.TARGET_FILL_PCT    = DEFAULT_AIR
        core.FREQ_MAX_LIMIT     = DEFAULT_FMAX
        core.EARLY_CEIL_HZ      = DEFAULT_ECEIL

        stop_cnt_sl.set(DEFAULT_STOP)
        ctrl_start_sl.set(DEFAULT_CTRL)
        target_air_sl.set(DEFAULT_AIR)
        fmax_sl.set(DEFAULT_FMAX)
        early_ceil_sl.set(DEFAULT_ECEIL)
        hit_var.set(f'확신(Hits) : 0/{core.STOP_TRIGGER_COUNT}')
        voice_level_var.set('🎤 음성 목표 수위 : - %')              # 음성 수위도 초기화
        set_status('튜닝 값 초기화')

    lock_row = ctk.CTkFrame(tune, fg_color=C_CARD, corner_radius=12)
    lock_row.grid(row=1, column=0, sticky='ew', padx=12, pady=(0, 6))
    lock_row.grid_columnconfigure(2, weight=1)

    ctk.CTkButton(lock_row, text='초기화', height=28, width=70,
                  fg_color=C_CARD, hover_color='#EEF2FF',
                  border_color='#CBD5E1', border_width=2,
                  text_color=C_NAVY, font=('Malgun Gothic', 12, 'bold'),
                  command=reset_defaults).grid(row=0, column=0, sticky='w')

    ctk.CTkSwitch(lock_row, text='LOCK', variable=lock_var,
                  command=on_lock_toggle).grid(row=0, column=1, sticky='w', padx=(10, 12))

    ctk.CTkLabel(lock_row, textvariable=lock_hint, text_color=C_MUTED,
                 font=('Malgun Gothic', 12)).grid(row=0, column=2, sticky='w')

    SH = 18

    sliders_config = [
        (2, '정지 확신 카운트 (STOP_TRIGGER_COUNT)', stop_cnt_var,   3,    20,   17,
         lambda v: (stop_cnt_var.set(int(float(v))), apply_tuning())),
        (3, '제어 시작 시간 (CONTROL_START_TIME)',   ctrl_start_var, 1.0,  15.0, 140,
         lambda v: (ctrl_start_var.set(float(v)), apply_tuning())),
        (4, '목표 수위 (TARGET_FILL_PCT %)',          target_air_var, 10.0, 95.0, 85,
         lambda v: (target_air_var.set(round(float(v), 1)), apply_tuning())),
    ]

    slider_widgets = {}

    for row_i, label, var, from_, to_, steps, cmd in sliders_config:
        sec = ctk.CTkFrame(tune, fg_color=C_CARD, corner_radius=12)
        sec.grid(row=row_i, column=0, sticky='ew', padx=12,
                 pady=(6 if row_i > 2 else 0, 0))
        sec.grid_columnconfigure(0, weight=1)

        ctk.CTkLabel(sec, text=label, text_color=C_TEXT,
                     font=('Malgun Gothic', 13, 'bold')).grid(row=0, column=0, sticky='w')
        ctk.CTkLabel(sec, textvariable=var, text_color=C_MUTED,
                     font=('Malgun Gothic', 12)).grid(row=1, column=0, sticky='w', pady=(0, 4))

        sl = ctk.CTkSlider(sec, from_=from_, to=to_, number_of_steps=steps,
                           height=SH, command=cmd)
        sl.set(var.get())
        sl.grid(row=2, column=0, sticky='ew', pady=(2, 8))
        slider_widgets[label] = sl

    stop_cnt_sl   = slider_widgets['정지 확신 카운트 (STOP_TRIGGER_COUNT)']
    ctrl_start_sl = slider_widgets['제어 시작 시간 (CONTROL_START_TIME)']
    target_air_sl = slider_widgets['목표 수위 (TARGET_FILL_PCT %)']

    bottom = ctk.CTkFrame(tune, fg_color=C_CARD, corner_radius=12)
    bottom.grid(row=5, column=0, sticky='ew', padx=12, pady=(10, 12))
    bottom.grid_columnconfigure(0, weight=1)
    bottom.grid_columnconfigure(1, weight=1)

    for col_i, (title, var, from_, to_, steps, default) in enumerate([
        ('초반 상한 (EARLY_CEIL_HZ)',   early_ceil_var, 300, 1500, 120, DEFAULT_ECEIL),
        ('최대 탐색 주파수 (FREQ_MAX)', fmax_var,       800, 5000, 420, DEFAULT_FMAX),
    ]):
        box = ctk.CTkFrame(bottom, fg_color=C_CARD, corner_radius=12)
        box.grid(row=0, column=col_i, sticky='ew',
                 padx=(0 if col_i == 0 else 10, 10 if col_i == 0 else 0))
        box.grid_columnconfigure(0, weight=1)

        ctk.CTkLabel(box, text=title, text_color=C_TEXT,
                     font=('Malgun Gothic', 13, 'bold')).grid(row=0, column=0, sticky='w')
        ctk.CTkLabel(box, textvariable=var, text_color=C_MUTED,
                     font=('Malgun Gothic', 12)).grid(row=1, column=0, sticky='w', pady=(0, 4))

        sl = ctk.CTkSlider(box, from_=from_, to=to_, number_of_steps=steps, height=SH,
                           command=lambda v, _v=var: (_v.set(int(float(v))), apply_tuning()))
        sl.set(default)
        sl.grid(row=2, column=0, sticky='ew', pady=(2, 8))

        if col_i == 0:
            early_ceil_sl = sl
        else:
            fmax_sl = sl

    on_lock_toggle()

    prog_area = ctk.CTkFrame(right, fg_color=C_CARD, corner_radius=16)
    prog_area.pack(fill='x', pady=(0, 12))

    ctk.CTkLabel(prog_area, text='정지 확신도', text_color=C_TEXT,
                 font=('Malgun Gothic', 16, 'bold')).pack(anchor='w', pady=(0, 8))

    progress = ctk.CTkProgressBar(prog_area, height=18, corner_radius=10,
                                  fg_color='#E5E7EB', progress_color=C_NAVY)
    progress.set(0.0)
    progress.pack(fill='x')

    stats = ctk.CTkFrame(right, fg_color=C_CARD, corner_radius=16)
    stats.pack(fill='x', pady=(0, 12))

    # 기존 수치 표시 항목
    for v in [d_var, f_var, tf_var, air_var, vol_var, init_air_var, hit_var]:
        r = ctk.CTkFrame(stats, fg_color=C_CARD, corner_radius=12)
        r.pack(fill='x', pady=4)
        ctk.CTkLabel(r, textvariable=v, text_color=C_TEXT,
                     font=('Malgun Gothic', 16, 'bold')).pack(anchor='w', padx=6)

    # 음성 목표 수위 표시 (초록색 강조)
    voice_level_row = ctk.CTkFrame(stats, fg_color='#F0FFF4', corner_radius=12)
    voice_level_row.pack(fill='x', pady=4)
    ctk.CTkLabel(voice_level_row, textvariable=voice_level_var,
                 text_color=C_GREEN,
                 font=('Malgun Gothic', 16, 'bold')).pack(anchor='w', padx=6)

    # ── 실험 자동 기록 정보 ────────────────────────────────────────
    exp_info = ctk.CTkFrame(right, fg_color=C_CARD, corner_radius=12)
    exp_info.pack(fill='x', pady=(0, 8))

    ctk.CTkLabel(exp_info, textvariable=trial_var, text_color=C_NAVY,
                 font=('Malgun Gothic', 13, 'bold')).grid(
        row=0, column=0, sticky='w', padx=(4, 10), pady=(2, 4))

    ctk.CTkLabel(exp_info, text='컵 이름', text_color=C_TEXT,
                 font=('Malgun Gothic', 11, 'bold')).grid(row=0, column=1, padx=(0, 4))
    cup_name_entry = ctk.CTkEntry(exp_info, width=150, font=('Malgun Gothic', 11))
    cup_name_entry.insert(0, '250mL_beaker')
    cup_name_entry.grid(row=0, column=2, columnspan=2, padx=(0, 8), sticky='w')

    ctk.CTkLabel(exp_info, text='H(cm)', text_color=C_TEXT,
                 font=('Malgun Gothic', 11, 'bold')).grid(row=1, column=1, padx=(0, 4), pady=(0, 3))
    cup_height_entry = ctk.CTkEntry(exp_info, width=62, placeholder_text='선택',
                                    font=('Malgun Gothic', 11))
    cup_height_entry.grid(row=1, column=2, padx=(0, 8), pady=(0, 3))

    ctk.CTkLabel(exp_info, text='상단D', text_color=C_TEXT,
                 font=('Malgun Gothic', 11, 'bold')).grid(row=1, column=3, padx=(0, 4), pady=(0, 3))
    cup_top_d_entry = ctk.CTkEntry(exp_info, width=62, placeholder_text='선택',
                                   font=('Malgun Gothic', 11))
    cup_top_d_entry.grid(row=1, column=4, padx=(0, 8), pady=(0, 3))

    ctk.CTkLabel(exp_info, text='하단D', text_color=C_TEXT,
                 font=('Malgun Gothic', 11, 'bold')).grid(row=1, column=5, padx=(0, 4), pady=(0, 3))
    cup_bottom_d_entry = ctk.CTkEntry(exp_info, width=62, placeholder_text='선택',
                                      font=('Malgun Gothic', 11))
    cup_bottom_d_entry.grid(row=1, column=6, padx=(0, 4), pady=(0, 3))

    # [v5.33] 실측 컵 용적: 가장자리까지 물을 채운 무게(g) ≈ mL. 자동 라벨의 기준 용적
    ctk.CTkLabel(exp_info, text='실측용적(mL)', text_color=C_TEXT,
                 font=('Malgun Gothic', 11, 'bold')).grid(row=0, column=4, padx=(0, 4))
    cup_volume_entry = ctk.CTkEntry(exp_info, width=62, placeholder_text='선택',
                                    font=('Malgun Gothic', 11))
    cup_volume_entry.grid(row=0, column=5, padx=(0, 8), pady=(2, 4))

    plot_frame = ctk.CTkFrame(right, fg_color=C_CARD, corner_radius=16)
    plot_frame.pack(fill='both', expand=True)

    graph_header = ctk.CTkFrame(plot_frame, fg_color=C_CARD)
    graph_header.pack(fill='x', pady=(0, 6))

    ctk.CTkLabel(graph_header, text='실시간 주파수 추적 그래프',
                 text_color=C_TEXT,
                 font=('Malgun Gothic', 16, 'bold')
                 ).pack(side='left')

    actual_air_frame = ctk.CTkFrame(graph_header, fg_color=C_CARD)

    ctk.CTkLabel(actual_air_frame, text='실측(선택, %):',
                 text_color=C_NAVY,
                 font=('Malgun Gothic', 12, 'bold')
                 ).pack(side='left', padx=(14, 4))

    actual_air_entry = ctk.CTkEntry(actual_air_frame, width=72,
                                    placeholder_text='예) 75.0',
                                    font=('Malgun Gothic', 12))
    actual_air_entry.pack(side='left', padx=(0, 6))

    def on_confirm_save():
        """[v5.33] 자동 저장된 Trial 행에 실측 채움률(선택)을 덧붙인다. 자동 라벨 검증용."""
        data = _pending_save[0]
        if data is None:
            return
        raw = actual_air_entry.get().strip()
        try:
            fill_pct_input = max(0.0, min(100.0, float(raw)))
        except ValueError:
            set_status('실측 채움률은 숫자로 입력하세요. 예) 75.0')
            return
        init_air = data.get('init_air', 0.0)
        actual_air = (1.0 - fill_pct_input / 100.0) * init_air if init_air > 0 else None  # % → cm 역변환
        try:
            if exp_rec.update_manual_label(data['trial_id'], fill_pct_input, actual_air_cm=actual_air):
                trial_var.set(f"Trial : {data['trial_id']} 실측 {fill_pct_input:.1f}% 기록")
                set_status('실측 채움률 기록 완료')
            else:
                set_status('실측 채움률 기록 실패 (Trial 행을 찾지 못함)')
        except Exception as e:
            print(f'\n[REC 실측 기록 오류] {e}')
            set_status(f'실측 채움률 기록 오류: {e}')
            return
        _pending_save[0] = None
        actual_air_frame.pack_forget()
        actual_air_entry.delete(0, 'end')

    ctk.CTkButton(actual_air_frame, text='저장', width=60, height=28,
                  fg_color=C_NAVY, hover_color=C_NAVY_HOVER,
                  font=('Malgun Gothic', 12, 'bold'), corner_radius=8,
                  command=on_confirm_save).pack(side='left')

    fig = Figure(figsize=(6.2, 3.0), dpi=100)
    ax  = fig.add_subplot(111)
    ax.set_xlabel('t [s]')
    ax.set_ylabel('f [Hz]')
    ax.grid(True, alpha=0.3)
    fig.tight_layout(pad=3.0)

    line_freq,     = ax.plot([], [], linewidth=1.7, label='3rd_freq')
    line_stop,     = ax.plot([], [], linewidth=1.2, linestyle='-.', alpha=0.85, label='2nd_freq')
    line_detected, = ax.plot([], [], linewidth=1.0, alpha=0.70, label='1st_freq')
    line_ctrl,     = ax.plot([], [], linewidth=1.5, linestyle='--', label='ctrl_freq')   # [v5.33] 제어용 1초 중앙값
    target_line = ax.axhline(y=0, linestyle='--', alpha=0.8, label='target_f')
    ax.legend(loc='upper left', fontsize=8)
    canvas = FigureCanvasTkAgg(fig, master=plot_frame)
    canvas.get_tk_widget().pack(fill='both', expand=True)

    _init_air_fixed = [None]

    def periodic_update():
        try:
            with core.lock:
                d          = float(core.current_diameter)
                sf         = float(core.last_stable_f)
                tf         = float(core.target_freq)
                fill_pct   = float(core.last_fill_pct)
                hits       = int(core.consecutive_stop_hits)
                finish     = bool(core.request_finish)

                if core.request_finish:
                    core.request_finish = False

                t_list        = list(core.history_time)
                f_list        = list(core.history_freq)
                detected_list = list(getattr(core, 'history_detected_freq', []))
                stop_list     = list(getattr(core, 'history_stop_freq', []))
                ctrl_list     = list(getattr(core, 'history_ctrl_freq', []))
                t_mode        = bool(core.tracking_mode)
                init_air_c    = float(core.init_air_len_cm)
                cup_vol_c     = float(core.cup_volume_ml)
                fill_ml_c     = float(core.last_fill_volume_ml)
            poured_ml_c = core.poured_volume_ml()

            d_var.set(f'지름(D) : {d:.2f} cm' if d > 0 else '지름(D) : - cm')
            f_var.set(f'주파수(F) : {sf:.0f} Hz' if sf > 0 else '주파수(F) : - Hz')

            # [PCT] 목표 수위: core.TARGET_FILL_PCT 직접 사용
            tf_var.set(f'목표(Target) : {core.TARGET_FILL_PCT:.1f} %' if tf > 0 else '목표(Target) : - %')

            # [v5.33-VOLUME] 현재 수위: mL 기준 % (채운 mL / 컵 용적 mL)
            if init_air_c > 0 and fill_pct > 0 and cup_vol_c > 0:
                air_var.set(f'수위(Level) : {fill_pct:.1f} % ({fill_ml_c:.0f}/{cup_vol_c:.0f} mL)')
            else:
                air_var.set('수위(Level) : - %')
            vol_var.set(f'급수량(Q·t) : {poured_ml_c:.0f} mL' if poured_ml_c > 0 else '급수량(Q·t) : - mL')

            if _init_air_fixed[0] is None and init_air_c > 0:
                _init_air_fixed[0] = init_air_c
                init_air_var.set(f'초기 공기층(용기 높이) : {init_air_c:.2f} cm')

            hit_var.set(f'확신(Hits) : {hits}/{core.STOP_TRIGGER_COUNT}')
            progress.set(hits / float(max(1, core.STOP_TRIGGER_COUNT)))
            progress.configure(progress_color='#0B7A3E' if t_mode else C_NAVY)

            if t_list:
                # 3개 그래프가 같은 x축을 쓰도록 길이를 맞춘다.
                n_plot = min(len(t_list), len(f_list))
                if n_plot > 0:
                    n_plot = min(n_plot, core.PLOT_MAX_POINTS)
                    t_list = t_list[-n_plot:]
                    f_list = f_list[-n_plot:]

                    # detected_f / f_for_stop은 구버전 core와의 호환을 위해 부족하면 빈 그래프로 둔다.
                    if len(detected_list) >= n_plot:
                        detected_plot = detected_list[-n_plot:]
                        line_detected.set_data(t_list, detected_plot)
                    else:
                        detected_plot = []
                        line_detected.set_data([], [])

                    if len(stop_list) >= n_plot:
                        stop_plot = stop_list[-n_plot:]
                        line_stop.set_data(t_list, stop_plot)
                    else:
                        stop_plot = []
                        line_stop.set_data([], [])

                    if len(ctrl_list) >= n_plot:
                        ctrl_plot = ctrl_list[-n_plot:]
                        line_ctrl.set_data(t_list, ctrl_plot)
                    else:
                        ctrl_plot = []
                        line_ctrl.set_data([], [])

                    line_freq.set_data(t_list, f_list)

                    t_max = max(t_list)
                    ax.set_xlim(max(0, t_max - 30), max(5, t_max))

                    y_values = []
                    for arr in (f_list, detected_plot, stop_plot, ctrl_plot):
                        y_values.extend([float(v) for v in arr if v is not None and float(v) > 0])
                    if tf > 0:
                        y_values.append(float(tf))

                    if y_values:
                        fmn, fmx = min(y_values), max(y_values)
                        pad = max(50, 0.1 * (fmx - fmn))
                        ax.set_ylim(max(0, fmn - pad), fmx + pad)

                    if tf > 0:
                        target_line.set_ydata([tf, tf])
                        target_line.set_alpha(0.9)
                    else:
                        target_line.set_alpha(0.0)
            else:
                line_freq.set_data([], [])
                line_detected.set_data([], [])
                line_stop.set_data([], [])
                line_ctrl.set_data([], [])
                ax.set_xlim(0, 1)
                ax.set_ylim(core.FREQ_MIN_LIMIT, core.FREQ_MAX_LIMIT)
                target_line.set_alpha(0.0)

            canvas.draw_idle()

            if finish:
                with core.lock:
                    init_f_save      = float(core.initial_stable_freq)
                    r2               = float(core.last_r2)
                    freq_snapshot    = list(core.history_freq_snapshot)
                    t_intercept_s    = float(core.theory_intercept)
                    init_air_save    = float(core.init_air_len_cm)
                    stop_air_save    = float(core.last_current_air)
                    target_pct_save  = float(core.TARGET_FILL_PCT)
                    stop_elapsed_sec = float(getattr(core, 'last_stop_elapsed_sec', 0.0))
                    cup_vol_est      = float(core.cup_volume_ml)

                total_samples = len(freq_snapshot)
                print(f'\n[DEBUG] 샘플수={total_samples} | R2={r2}')

                # [v5.33] 기준 용적: 입력칸 → cup_info.csv 등록값 → (없으면 추정 용적)
                cup_name = cup_name_entry.get().strip() or 'unknown'
                cup_ref_ml = _optional_float(cup_volume_entry) or exp_rec.get_cup_volume_ml(cup_name)
                label_pct, label_src, _ = core.compute_label_pct(core.poured_volume_ml(), cup_ref_ml, cup_vol_est)

                # 급수 종료 시 시계열 + core 최종 상태 저장 → 자동 라벨로 trial_summary 즉시 저장
                finished_trial = None
                try:
                    finished_trial = exp_rec.capture_finish(core)
                    if finished_trial:
                        exp_rec.finalize_trial(core)
                except Exception as e:
                    print(f'\n[REC 자동 저장 오류] {e}')

                save_to_csv(
                    d, init_f_save, tf, sf,
                    r2_final=r2,
                    total_samples=total_samples,
                    theory_intercept=t_intercept_s,
                    estimated_stop_air_cm=stop_air_save,
                    init_air_len_cm=init_air_save,
                    cup_type=cup_name,
                    target_fill_pct=target_pct_save,
                    stop_elapsed_sec=stop_elapsed_sec,
                    cup_volume_ref_ml=cup_ref_ml,
                )

                label_txt = '-' if label_pct is None else f'{label_pct:.1f}%'
                src_txt = {'measured_cup_volume': '실측용적', 'estimated_cup_volume': '추정용적'}.get(label_src, '없음')
                if finished_trial:
                    trial_var.set(f'Trial : {finished_trial} 자동 저장 (라벨 {label_txt}, {src_txt})')
                    _pending_save[0] = {'trial_id': finished_trial, 'init_air': init_air_save}
                    actual_air_entry.delete(0, 'end')
                    actual_air_frame.pack(side='right')                # 실측값 입력은 선택 사항
                set_status(f'측정 완료 → 자동 라벨 {label_txt} 저장 (실측값 입력은 선택)')

                _init_air_fixed[0] = None
                init_air_var.set('초기 공기층(용기 높이) : - cm')

        except Exception as e:
            print(f'\n[periodic_update 오류] {e}')

        finally:
            app.after(100, periodic_update)

    footer = ctk.CTkFrame(card, fg_color=C_CARD, corner_radius=20)
    footer.grid(row=2, column=0, sticky='ew', padx=24, pady=(0, 18))

    ctk.CTkLabel(footer, textvariable=status_var, text_color=C_MUTED,
                 font=('Malgun Gothic', 14)).pack(anchor='w')

    core.sw_on.when_pressed  = gui_on
    core.sw_off.when_pressed = gui_off
    app.protocol('WM_DELETE_WINDOW', on_close)
    core.solenoid_off()

    # ── 음성인식 콜백 등록 ──────────────────────────────────────────
    try:
        import voice_module as vm

        # ON/OFF 콜백
        vm.register_gui_callbacks(gui_on, gui_off)

        # 수위 설정 콜백: 음성으로 수위 설정 시 슬라이더 + 표시 즉시 갱신
        def _on_voice_level(pct: float):
            try:
                target_air_var.set(round(pct, 1))                   # 슬라이더 값 갱신
                target_air_sl.set(pct)                              # 슬라이더 위치 갱신
                voice_level_var.set(f'🎤 음성 목표 수위 : {pct:.0f} %')  # 표시 갱신

                # apply_tuning()과 동일하게 core._eff_target_air_cm 재계산
                core.TARGET_FILL_PCT = pct
                with core.lock:
                    init_air = float(core.init_air_len_cm)
                    if init_air > 0:
                        core._eff_target_air_cm = max(0.5, init_air * (1.0 - pct / 100.0))
                    if core.calibration_done and core.current_diameter > 0 and core._eff_target_air_cm > 0:
                        core.target_freq = float(
                            core.SOUND_SPEED / (4 * (core._eff_target_air_cm + core.END_CORRECTION_K * core.current_diameter))
                        )

                print(f'\n[GUI] 음성 목표 수위 갱신: {pct:.0f}%')
            except Exception as e:
                print(f'\n[GUI] 음성 수위 콜백 오류: {e}')

        vm.register_gui_level_callback(_on_voice_level)

    except Exception as e:
        print(f'\n[GUI] 콜백 등록 오류 (단독 실행 시 무시): {e}')

    set_status('GPIO 제어 모드 준비 완료')
    periodic_update()

    if callable(on_ready):
        app.after(300, on_ready)  # GUI 초기화 후 음성인식 스레드 시작

    app.mainloop()
