class INA219Monitor:
    """별도 스레드에서 I2C 처리: GPIO STOP 처리 중 I2C 응답을 기다리지 않는다."""
    def __init__(self, clock=time.monotonic, bus_factory=None):
        self.clock, self.bus_factory = clock, bus_factory
        self.lock = threading.Lock()
        self.value = self.updated = None
        self.error = "INA219 첫 측정 대기 중"
        self.stop_event = threading.Event()
        self.worker = None

    @staticmethod
    def decode(data):
        if len(data) != 2 or any(not isinstance(x, int) or not 0 <= x <= 255 for x in data):
            raise ValueError("INA219 전압 데이터 형식 오류")
        voltage = (((data[0] << 8) | data[1]) >> 3) * 0.004
        if not 0 < voltage <= 26:
            raise ValueError(f"INA219 전압 {voltage:.3f}V: VIN−/GND 및 전원을 확인하세요.")
        return voltage

    def snapshot(self):
        with self.lock:
            return dict(value=self.value, updated=self.updated, error=self.error)

    def start(self):
        self.worker = threading.Thread(target=self._work, name="ina219-monitor", daemon=True)
        self.worker.start()

    def _work(self):
        bus = None
        try:
            if self.bus_factory is None:
                from smbus2 import SMBus
                factory = SMBus
            else:
                factory = self.bus_factory
            bus = factory(INA219_BUS)
            # 32V 레인지, 12bit, 버스 전압 연속 측정. MSB 먼저 전송한다.
            bus.write_i2c_block_data(INA219_ADDRESS, 0x00, [0x21, 0x9E])
            if self.stop_event.wait(0.01):
                return
            while not self.stop_event.is_set():
                try:
                    value = self.decode(bus.read_i2c_block_data(INA219_ADDRESS, 0x02, 2))
                    with self.lock:
                        self.value, self.updated, self.error = value, self.clock(), ""
                except Exception as exc:
                    with self.lock:
                        self.error = f"INA219 읽기 실패: {exc}"
                if self.stop_event.wait(VOLTAGE_INTERVAL):
                    break
        except Exception as exc:
            with self.lock:
                self.error = f"INA219 초기화 실패: {exc}"
        finally:
            if bus is not None:
                try:
                    bus.close()
                except Exception:
                    traceback.print_exc()

    def close(self):
        self.stop_event.set()
        if self.worker is not None:
            self.worker.join(timeout=1)


class FlowCounter:
    def __init__(self, clock=time.monotonic):
        self.clock = clock
        self.lock = threading.Lock()
        self.created = clock()
        self.raw = self.accepted = self.rejected = self.zero = 0
        self.last_tick = self.last_time = None
        self.times = deque()
        self.min_ns = 200000

    def set_filter(self, microseconds):
        with self.lock:
            self.min_ns = round(microseconds * 1000)

    def rising(self, tick_ns, arrival=None):
        now = self.clock() if arrival is None else arrival
        with self.lock:
            self.raw += 1
            if self.last_tick is not None and tick_ns - self.last_tick < self.min_ns:
                self.rejected += 1
                return
            self.accepted += 1
            self.last_tick, self.last_time = tick_ns, now
            self.times.append(now)
            while self.times and self.times[0] < now - 2:
                self.times.popleft()

    def snapshot(self, now=None):
        now = self.clock() if now is None else now
        with self.lock:
            while self.times and self.times[0] <= now - 1:
                self.times.popleft()
            window = min(1.0, max(now - self.created, 0.001))
            return dict(total=self.accepted, display=self.accepted-self.zero,
                        raw=self.raw, rejected=self.rejected, hz=len(self.times)/window,
                        last=self.last_time)

    def reset_display(self):
        with self.lock:
            self.zero = self.accepted


class StopHeld(RuntimeError):
    pass


class RPiHardware:
    simulated = False

    def __init__(self, flow):
        import lgpio
        self.lg = lgpio
        self.handle = None
        self.callback = None
        self.claimed = []
        self.outputs = dict(pump=0.0, valve=False, led12=False, board=False)
        self.pwm_frequency = 1000.0
        self._pwm_active = False
        try:
            self.handle = lgpio.gpiochip_open(GPIO_CHIP)
            info = lgpio.gpio_get_chip_info(self.handle)
            if "rp1" not in " ".join(map(str, info)).lower():
                raise RuntimeError(f"gpiochip{GPIO_CHIP}가 RP1 헤더 장치인지 확인하세요: {info}")
            for name in ("start", "stop"):
                lgpio.gpio_claim_input(self.handle, PINS[name], lgpio.SET_PULL_UP)
                self.claimed.append(name)
            for name in ("pump", "valve", "led12", "board"):
                lgpio.gpio_claim_output(self.handle, PINS[name], 0)
                self.claimed.append(name)
            lgpio.gpio_claim_alert(self.handle, PINS["flow"], lgpio.RISING_EDGE,
                                   lgpio.SET_PULL_NONE)
            self.claimed.append("flow")
            self.callback = lgpio.callback(
                self.handle, PINS["flow"], lgpio.RISING_EDGE,
                lambda chip, gpio, level, tick: flow.rising(tick) if level == 1 else None)
        except BaseException:
            self.close()
            raise

    def buttons(self):
        return (not bool(self.lg.gpio_read(self.handle, PINS["start"])),
                not bool(self.lg.gpio_read(self.handle, PINS["stop"])))

    def set(self, name, value, frequency=1000.0):
        if value and self.buttons()[1]:
            raise StopHeld("STOP 버튼이 눌려 있습니다.")
        if name == "pump":
            value = float(value)
            if value:
                result = self.lg.tx_pwm(self.handle, PINS[name], frequency, value)
                if result < 0:
                    raise RuntimeError(f"PWM 오류: {result}")
                self.pwm_frequency = frequency
                self._pwm_active = True
            else:
                # PWM을 한 번도 시작하지 않은 LED 시험에서도 all_off가 호출된다.
                # 이때 불필요한 tx_pwm(0,0)을 보내지 않는다. 실행 중인 PWM은
                # 유효한 기존 주파수에서 duty=0으로 바꾸고 LOW를 명령한다.
                # PWM API가 실패해도 LOW 명령은 시도하며 오류를 숨기지 않는다.
                try:
                    if self._pwm_active:
                        result = self.lg.tx_pwm(self.handle, PINS[name], self.pwm_frequency, 0)
                        if result < 0:
                            raise RuntimeError(f"PWM 정지 오류: {result}")
                        self._pwm_active = False
                finally:
                    self.lg.gpio_write(self.handle, PINS[name], 0)
        else:
            self.lg.gpio_write(self.handle, PINS[name], int(bool(value)))
        self.outputs[name] = value

    def all_off(self):
        errors = []
        for name in ("pump", "valve", "led12", "board"):
            if name in self.claimed:
                try:
                    self.set(name, 0)
                except Exception as exc:
                    errors.append(f"{name}: {exc}")
        if errors:
            raise RuntimeError(" / ".join(errors))

    def close(self):
        if self.handle is None:
            return
        try:
            self.all_off()
        except Exception:
            traceback.print_exc()
        if self.callback is not None:
            try:
                self.callback.cancel()
            except Exception:
                traceback.print_exc()
        try:
            self.lg.gpiochip_close(self.handle)
        finally:
            self.handle = None

    def advance(self, dt, now):
        pass


class WaterHardware:
    """GPIO를 단독 소유한다. I2C는 별도 스레드이며 STOP이 I2C를 기다리지 않는다."""
    def __init__(self, io=None, voltage=None, clock=time.monotonic, wall_clock=time.time):
        self.clock, self.wall_clock = clock, wall_clock
        self.lock = threading.RLock()
        self.events = queue.Queue()
        self.flow = FlowCounter(clock)
        self.flow.set_filter(FLOW_MIN_EDGE_US)
        self.io = io if io is not None else RPiHardware(self.flow)
        self.voltage = voltage if voltage is not None else INA219Monitor(clock)
        self.phase = 'IDLE'
        self.run_id = 0
        self.stop_generation = 0  # STOP 이전에 대기열에 들어간 시작 명령을 무효화
        self.reason = self.error = ''
        self.deadline = self.started = self.last_pwm = 0.0
        self.pump_started_wall = 0.0
        self.last_run_duty = 0.0
        self.last_run_voltage = None
        self.baseline = 0
        self._stop = threading.Event()
        self._worker = None
        self._start_raw = self._start_stable = True  # 시작 시 눌린 버튼으로 자동 가동하지 않음
        self._start_since = clock()
        self._stop_raw = False
        self._closed = False

    def start_monitoring(self):
        with self.lock:
            if self._worker is not None:
                return
            self.voltage.start()
            self._worker = threading.Thread(target=self._work, name='pcb-control', daemon=True)
            self._worker.start()

    def _voltage(self):
        s = self.voltage.snapshot()
        value, updated = s['value'], s['updated']
        age = None if updated is None else self.clock() - updated
        error = s['error']
        if not error and (age is None or age < 0 or age > VOLTAGE_MAX_AGE):
            error = 'INA219 측정값 갱신 지연 (1초 초과)'
        if not error and (value is None or not math.isfinite(value) or not 0 < value <= 26):
            error = 'INA219 전압값 오류'
        return dict(value=value, age=age, error=error)

    def _duty(self):
        s = self._voltage()
        if s['error']:
            raise RuntimeError(s['error'])
        if not math.isfinite(PUMP_TARGET_V) or not 0 < PUMP_TARGET_V <= 10.0:
            raise ValueError('펌프 목표 환산 전압은 0V 초과 10V 이하입니다.')
        if s['value'] < PUMP_TARGET_V:
            raise RuntimeError(f"배터리 {s['value']:.3f}V < 목표 {PUMP_TARGET_V:g}V")
        return 100.0 * PUMP_TARGET_V / s['value']

    def begin_run(self, calibration_s, expected_generation=None):
        if not math.isfinite(calibration_s) or not 0 <= calibration_s <= 60:
            raise ValueError('소음 측정 시간은 0~60초입니다.')
        if not (math.isfinite(PUMP_PWM_HZ) and 10 <= PUMP_PWM_HZ <= 10000):
            raise ValueError('PWM 주파수는 10~10000Hz입니다.')
        if not all(math.isfinite(x) and x >= 0 for x in
                   (VALVE_LEAD_S, VALVE_TAIL_S, MAX_RUN_S)):
            raise ValueError('밸브 대기/최대 운전 시간 설정을 확인하세요.')
        if not math.isfinite(FLOW_PULSES_PER_LITRE) or FLOW_PULSES_PER_LITRE <= 0:
            raise ValueError('유량센서 펄스/L은 양수여야 합니다.')
        with self.lock:
            if expected_generation is not None and expected_generation != self.stop_generation:
                raise StopHeld('시작 요청 이후 STOP이 입력되어 시작을 취소했습니다.')
            if self._closed or self.phase != 'IDLE':
                raise RuntimeError(f'하드웨어가 대기 상태가 아닙니다: {self.phase} {self.error}')
            if self.io.buttons()[1]:
                raise StopHeld('STOP 버튼이 눌려 있습니다.')
            self._duty()  # 첫 정상 전압 확인 전에는 밸브도 열지 않음
            self.io.all_off()
            self.run_id += 1
            self.reason = self.error = ''
            self.started = self.clock()
            self.deadline = self.started + calibration_s + 0.1
            self.baseline = self.flow.snapshot()['total']
            self.pump_started_wall = 0.0
            self.last_run_duty = 0.0
            self.last_run_voltage = None
            self.phase = 'CALIBRATION'
            return self.run_id

    def stop(self, reason='manual_stop', normal=False, fault=False):
        """모든 종료 경로에서 펌프를 먼저 끈다. 긴급/오류는 밸브도 즉시 OFF."""
        with self.lock:
            if self._closed:
                return
            active = self.phase in ('CALIBRATION', 'LEAD', 'ON')
            self.stop_generation += 1
            old_fault = self.phase == 'FAULT'
            errors = []
            for name in ('pump', 'led12', 'board'):
                try:
                    self.io.set(name, 0)
                except Exception as exc:
                    errors.append(f'{name}: {exc}')
            tail = normal and active and bool(self.io.outputs['valve']) and not errors
            if tail:
                self.phase, self.deadline = 'TAIL', self.clock() + VALVE_TAIL_S
            else:
                try:
                    self.io.set('valve', 0)
                except Exception as exc:
                    errors.append(f'valve: {exc}')
                self.phase = 'FAULT' if fault or errors or old_fault else 'IDLE'
            if active or fault or errors:
                self.reason = str(reason)
            if fault or errors:
                self.error = str(reason) + (' / ' + ' / '.join(errors) if errors else '')
                self.phase = 'FAULT'
            if active or fault or errors:
                self.events.put(('stopped', self.run_id, self.snapshot()))

    def snapshot(self):
        with self.lock:
            s = self._voltage()
            f = self.flow.snapshot()
            pulses = max(0, f['total'] - self.baseline)
            return dict(phase=self.phase, run_id=self.run_id, stop_generation=self.stop_generation,
                        reason=self.reason, error=self.error, battery_v=s['value'],
                        battery_age_s=s['age'], voltage_error=s['error'],
                        pump_duty_pct=float(self.io.outputs['pump']), pump_target_v=PUMP_TARGET_V,
                        pump_last_duty_pct=self.last_run_duty,
                        pump_est_avg_v=(self.last_run_voltage*self.last_run_duty/100
                                        if self.last_run_voltage is not None else 0.0),
                        pwm_hz=PUMP_PWM_HZ, valve_on=bool(self.io.outputs['valve']),
                        pump_started_wall=self.pump_started_wall,
                        flow_hz=f['hz'], flow_l_min=f['hz']*60/FLOW_PULSES_PER_LITRE,
                        run_pulses=pulses, run_volume_ml=pulses*1000/FLOW_PULSES_PER_LITRE,
                        raw_pulses=f['raw'], rejected_edges=f['rejected'])

    def _tick(self):
        with self.lock:
            now = self.clock()
            start, stop = self.io.buttons()
            if stop:
                if not self._stop_raw or self.phase in ('CALIBRATION', 'LEAD', 'ON', 'TAIL'):
                    self.stop('physical_STOP')
                self._start_raw = self._start_stable = True  # 동시 누름 후 START를 놓아야 재시작
                self._start_since = now
            self._stop_raw = stop
            if start != self._start_raw:
                self._start_raw, self._start_since = start, now
            if now - self._start_since >= 0.03 and start != self._start_stable:
                self._start_stable = start
                if start and not stop and self.phase == 'IDLE':
                    self.events.put(('start_button', self.run_id, self.stop_generation))
            if self.phase in ('IDLE', 'FAULT', 'CLOSED'):
                return
            if self.phase == 'TAIL':
                if now >= self.deadline:
                    self.io.set('valve', 0)
                    self.phase = 'IDLE'
                return
            duty = self._duty()  # 센서 오류/오래된 값/저전압일 때 이전 듀티를 유지하지 않음
            if MAX_RUN_S and now - self.started >= MAX_RUN_S:
                self.stop('max_run_time', fault=True)
                return
            if self.phase == 'CALIBRATION' and now >= self.deadline:
                self.io.set('valve', True)
                self.phase, self.deadline = 'LEAD', now + VALVE_LEAD_S
            elif self.phase == 'LEAD' and now >= self.deadline:
                self.io.set('pump', duty, PUMP_PWM_HZ)
                self.last_run_duty, self.last_run_voltage = duty, PUMP_TARGET_V*100/duty
                self.io.set('led12', True)
                self.io.set('board', True)
                self.pump_started_wall = self.wall_clock()
                self.last_pwm, self.phase = now, 'ON'
                self.events.put(('pump_on', self.run_id, self.pump_started_wall))
            elif self.phase == 'ON' and now - self.last_pwm >= VOLTAGE_INTERVAL:
                if abs(duty - self.io.outputs['pump']) >= 0.01:
                    self.io.set('pump', duty, PUMP_PWM_HZ)
                    self.last_run_duty, self.last_run_voltage = duty, PUMP_TARGET_V*100/duty
                self.last_pwm = now

    def tick(self):
        try:
            self._tick()
        except StopHeld:
            self.stop('physical_STOP')
        except Exception as exc:
            self.stop(str(exc), fault=True)
            # FAULT 상태에서는 재가동하지 않는다. 프로그램 재실행 후 확인한다.

    def _work(self):
        while not self._stop.wait(LOOP_SECONDS):
            self.tick()

    def close(self):
        with self.lock:
            if self._closed:
                return
            self.stop('app_close')
            self._closed = True
            self.phase = 'CLOSED'
            self._stop.set()
        if self._worker is not None and threading.current_thread() is not self._worker:
            self._worker.join(timeout=1.0)
        try:
            self.io.close()
        finally:
            self.voltage.close()


