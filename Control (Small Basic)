def initialize_hardware():
    global _hardware, _hardware_event_thread
    with _control_lock:
        if _hardware is None:
            _hardware = WaterHardware()
            _hardware.start_monitoring()
            _hardware_event_stop.clear()
            _hardware_event_thread = threading.Thread(
                target=_hardware_events, name='core-hardware-events', daemon=True)
            _hardware_event_thread.start()
    return _hardware


def hardware_status():
    return _hardware.snapshot() if _hardware is not None else {}


def enqueue_start():
    """음성/버튼 시작 요청. STOP이 먼저 처리되면 오래된 요청은 무효화한다."""
    hw = initialize_hardware()
    ui_requests.put(('start', hw.snapshot()['stop_generation']))


def _hardware_events():
    global water_started_time, filling_start_time
    while not _hardware_event_stop.is_set():
        try:
            kind, run_id, value = _hardware.events.get(timeout=0.1)
        except queue.Empty:
            continue
        try:
            _handle_hardware_event(kind, run_id, value)
        except Exception as exc:
            print(f'\n[PCB 상태 처리 오류] {exc}')
            _hardware.stop(str(exc), fault=True)


def _handle_hardware_event(kind, run_id, value):
    global water_started_time, filling_start_time
    with _control_lock:
        if kind == 'start_button':
            ui_requests.put(('start', value))
        elif run_id == _current_run_id:
            if kind == 'pump_on':
                with lock:
                    if is_filling:
                        water_started_time = value
                        # 원래의 elapsed-NOISE_CALIBRATION_TIME 식을 실제 펌프 ON에 맞춘다.
                        filling_start_time = value - NOISE_CALIBRATION_TIME
                print('\n>>> [2단계] 밸브 선행 완료. 펌프 PWM 가동!')
            elif kind == 'stopped':
                _finish_filling(True, value['reason'], value)


def _finish_filling(save_result, reason, snapshot):
    global is_filling, request_finish, history_freq_snapshot, last_stop_elapsed_sec
    global last_stop_reason, hardware_error, last_hardware_snapshot
    with lock:
        if not is_filling:
            return  # STOP 반복/늦게 도착한 이벤트로 완료 상태를 덮어쓰지 않음
        history_freq_snapshot = list(history_freq)
        last_stop_elapsed_sec = (max(0.0, time.time() - water_started_time)
                                 if water_started_time else 0.0)
        last_stop_reason = reason
        hardware_error = snapshot.get('error', '')
        last_hardware_snapshot = dict(snapshot)
        is_filling = False
        request_finish = bool(save_result)
    close_audio_stream_async(delay_sec=0.35)
    print(f'\n>>> 물 주입 종료: {reason}' + (f' / {hardware_error}' if hardware_error else ''))


def start_filling_local(expected_generation=None) -> bool:
    global _current_run_id, hardware_error, last_stop_reason, water_started_time
    global last_hardware_snapshot
    hw = initialize_hardware()
    if expected_generation is None:
        expected_generation = hw.snapshot()['stop_generation']
    # close 작업을 기다리는 동안 제어 락을 점유하지 않아 STOP 처리가 가능하다.
    with _audio_lifecycle_lock, _control_lock:
        with lock:
            if is_filling or _shutting_down:
                return False
        ensure_audio_stream()
        try:
            _current_run_id = hw.begin_run(NOISE_CALIBRATION_TIME, expected_generation)
            _reset_filling_state()
            with lock:
                hardware_error = last_stop_reason = ''
                water_started_time = 0.0
                last_hardware_snapshot = {}
            return True
        except Exception:
            hw.stop('start_failed')
            close_audio_stream_async()
            raise


def stop_filling_local(save_result=True, reason='manual_stop', immediate=True) -> None:
    with _control_lock:
        if _hardware is not None:
            _hardware.stop(reason, normal=not immediate,
                           fault=reason in ('audio_error', 'gui_error'))
            snapshot = _hardware.snapshot()
        else:
            snapshot = {}
        _finish_filling(save_result, reason, snapshot)


def shutdown_hardware():
    """GUI 종료/예외/인터럽트 시 출력과 GPIO 소유권을 정리한다."""
    global _shutting_down
    _shutting_down = True
    _hardware_event_stop.set()
    stop_filling_local(save_result=False, reason='app_close')
    if _hardware is not None:
        _hardware.close()
    _close_audio_if_idle(audio_stream)


