def cancel_pending_callbacks(app):
    import tkinter as tk  # GUI를 닫을 때만 Tk 의존성을 사용한다.
    try:
        jobs = app.tk.call('after', 'info')
        if isinstance(jobs, str):
            jobs = app.tk.splitlist(jobs)
        for job in jobs:
            # 자식 위젯/CustomTkinter 작업도 포함한다. Python 명령 삭제는
            # 소유 위젯의 destroy에 맡겨 중복 deletecommand 오류를 방지한다.
            app.tk.call('after', 'cancel', job)
    except tk.TclError:
        pass  # 이미 Tcl 인터프리터가 종료된 경우


def close_window(app, before_destroy=None):
    if getattr(app, '_water_closing', False):
        return
    app._water_closing = True  # 현재 실행 중인 콜백의 재예약도 차단
    cancel_pending_callbacks(app)
    try:
        if before_destroy is not None:
            before_destroy()
    finally:
        cancel_pending_callbacks(app)
        try:
            app.destroy()
        finally:
            cancel_pending_callbacks(app)
            app.quit()
