# 1. 새 PCB 설정 — GPIO/INA219/PWM/유량센서
# ──────────────────────────────────────────────────────────────────
GPIO_CHIP = 0  # 앞서 정상 작동한 RP1 gpiochip 번호
PINS = {"pump": 8, "valve": 18, "led12": 23, "board": 7,
        "start": 3, "stop": 5, "flow": 27}

INA219_BUS = 3  # GPIO0(SDA/물리27), GPIO1(SCL/물리28)의 i2c-gpio 버스
INA219_ADDRESS = 0x40
VOLTAGE_INTERVAL = 0.2  # 배터리 측정 및 PWM 갱신 간격(s)
VOLTAGE_MAX_AGE = 1.0  # 측정값 갱신 지연 허용 시간(s)
PUMP_TARGET_V = 10.0  # 목표 환산 평균 전압; 펌프 단자 DC 실측값은 아님
PUMP_PWM_HZ = 1000.0  # lgpio 소프트웨어 타이밍 PWM
VALVE_LEAD_S = 0.1  # 밸브를 먼저 열고 펌프를 켤 때까지 대기
VALVE_TAIL_S = 0.1  # 정상 완료 시 펌프 OFF 후 밸브를 닫을 때까지 대기
MAX_RUN_S = 300.0  # 테스트 코드의 최대 운전 시간; 0은 제한 해제
LOOP_SECONDS = 0.005  # STOP/상태 전이 확인 주기; OS에 따른 지연은 별도

FLOW_PULSES_PER_LITRE = 2280.0  # YF-S402B 초기값; 실측 보정 필요
FLOW_MIN_EDGE_US = 200.0  # 버튼 디바운스를 유량 입력에 적용하지 않음


