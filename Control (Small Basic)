def bind_controls(app, gui_on, gui_off, on_level, on_error):
    initialize_hardware()

    def request_start():
        if getattr(app, '_water_closing', False):
            return False
        reply = queue.Queue(maxsize=1)
        generation = hardware_status()['stop_generation']
        ui_requests.put(('start', generation, reply))
        try:
            return reply.get(timeout=5.0)
        except queue.Empty:
            # 늦게 처리되는 시작도 취소한다.
            stop_filling_local(True, reason='start_request_timeout')
            return False

    def request_stop():
        if getattr(app, '_water_closing', False):
            return
        stop_filling_local(True, reason='voice_stop')  # GUI 응답을 기다리지 않고 출력 OFF
        ui_requests.put(('stop', None))

    def poll():
        if getattr(app, '_water_closing', False):
            return
        try:
            for _ in range(30):
                if getattr(app, '_water_closing', False):
                    break
                try:
                    item = ui_requests.get_nowait()
                except queue.Empty:
                    break
                kind, value = item[:2]
                reply = item[2] if len(item) > 2 else None
                ok = False
                try:
                    if kind == 'start':
                        if value == hardware_status()['stop_generation']:
                            ok = bool(gui_on(expected_generation=value))
                    elif kind == 'stop':
                        gui_off()
                    elif kind == 'level':
                        on_level(value)
                except Exception as exc:
                    stop_filling_local(True, reason='gui_error')
                    on_error(str(exc))
                finally:
                    if reply is not None:
                        reply.put_nowait(ok)
        finally:
            if not getattr(app, '_water_closing', False):
                app.after(20, poll)

    if VOICE_ENABLED:
        try:
            import voice_module as vm
            vm.register_gui_callbacks(request_start, request_stop)
            vm.register_gui_level_callback(lambda pct: ui_requests.put(('level', pct)))
        except ImportError as exc:
            print(f'[음성 모듈 사용 불가] {exc}')
    app.after(20, poll)


def shutdown_gui():
    """새 음성 요청을 끊고 출력 OFF 후 대기 중인 시작 응답을 해제한다."""
    vm = sys.modules.get('voice_module')
    if vm is not None:
        vm._shutdown.set()
        vm.register_gui_callbacks(None, None)
        vm.register_gui_level_callback(None)
    try:
        shutdown_hardware()
    finally:
        while True:
            try:
                item = ui_requests.get_nowait()
            except queue.Empty:
                break
            if len(item) > 2:
                try:
                    item[2].put_nowait(False)
                except queue.Full:
                    pass


