def capture_finish(core: Any) -> Optional[str]:
    """급수 종료 직후 호출. 시계열 저장 + core 최종 상태 snapshot."""
    global _active, _pending
    with _state_lock:
        if _active is None:
            return None
        state = _active
        state["stop_event"].set()

    worker = state.get("worker")
    if worker is not None and worker.is_alive():
        worker.join(timeout=1.0)

    try:
        state["timeseries"].append(
            _snapshot_timeseries_row(
                core,
                state["trial_id"],
                len(state["timeseries"]),
                time.monotonic() - state["record_start_monotonic"],
            )
        )
    except Exception:
        pass

    ts_path = _write_timeseries(state["trial_id"], state["timeseries"])
    snap = _snapshot_summary(core)

    with _state_lock:
        _pending = {
            **state,
            "finished_at": datetime.now().isoformat(timespec="seconds"),
            "timeseries_file": str(ts_path),
            "summary_snapshot": snap,
        }
        _active = None

    print(f"\n[REC] {state['trial_id']} 캡처 종료 | TS={ts_path}")
    return state["trial_id"]


def finalize_trial(
    core: Any,
    *,
    actual_fill_pct: Optional[float] = None,
    actual_air_cm: Optional[float] = None,
) -> Optional[str]:
    """
    trial_summary.csv 한 줄 최종 저장.
    [v5.33] 실측값이 없어도 자동 라벨(Label_Fill_Pct)과 함께 바로 저장한다.
    라벨 기준 용적: cup_info.csv의 Cup_Volume_ml(실측) → 없으면 주파수 추정 용적.
    """
    global _pending
    with _state_lock:
        if _pending is None:
            return None
        pending = dict(_pending)

    snap = dict(pending["summary_snapshot"])
    cup = _read_cup_info(pending["cup_name"])
    target_pct = _safe_float(snap.get("Target_Fill_Pct"), 0.0) or 0.0
    actual_pct = _safe_float(actual_fill_pct, None)

    if actual_pct is not None:
        actual_pct = max(0.0, min(100.0, actual_pct))
        fill_error = actual_pct - target_pct
    else:
        fill_error = None

    label_pct, label_src, label_ref = core.compute_label_pct(
        snap.get("Poured_Volume_ml"), cup.get("Cup_Volume_ml"), snap.get("Cup_Volume_Est_ml"),
    )

    row = {
        "Trial_ID": pending["trial_id"],
        "Started_At": pending["started_at"],
        "Finished_At": pending["finished_at"],
        "Cup_Name": pending["cup_name"],
        "Cup_Height_cm": cup.get("Cup_Height_cm", ""),
        "Cup_Top_Diameter_cm": cup.get("Cup_Top_Diameter_cm", ""),
        "Cup_Bottom_Diameter_cm": cup.get("Cup_Bottom_Diameter_cm", ""),
        **snap,
        "Actual_Fill_Pct": "" if actual_pct is None else round(actual_pct, 3),
        "Fill_Error_Pct": "" if fill_error is None else round(fill_error, 3),
        "Actual_Air_cm": "" if actual_air_cm is None else actual_air_cm,
        "Code_Version": pending["code_version"],
        "Timeseries_File": pending["timeseries_file"],
        "Cup_Volume_Ref_ml": "" if label_ref is None else round(label_ref, 2),
        "Label_Fill_Pct": "" if label_pct is None else round(label_pct, 3),
        "Label_Source": label_src,
    }

    _append_csv(SUMMARY_FILE, SUMMARY_HEADER, row)
    trial_id = pending["trial_id"]
    with _state_lock:
        _pending = None

    label_txt = "-" if label_pct is None else f"{label_pct:.1f}%"
    print(f"\n[REC] {trial_id} 저장 완료 | Target={target_pct:.1f}% | Label={label_txt} ({label_src})"
          f" | Actual={actual_pct} | Error={fill_error}")
    return trial_id


def update_manual_label(
    trial_id: str,
    actual_fill_pct: float,
    actual_air_cm: Optional[float] = None,
) -> bool:
    """
    [v5.33] 이미 저장된 Trial 행에 실측 채움률(선택 입력)을 기록한다.
    자동 라벨 검증용. 파일 전체를 임시 파일에 다시 쓴 뒤 교체한다(중간 실패 시 원본 유지).
    """
    actual_pct = _safe_float(actual_fill_pct, None)
    if actual_pct is None or not SUMMARY_FILE.exists():
        return False
    actual_pct = max(0.0, min(100.0, actual_pct))

    with _state_lock:
        with SUMMARY_FILE.open("r", newline="", encoding="utf-8-sig") as f:
            reader = csv.DictReader(f)
            header = list(reader.fieldnames or [])
            rows = list(reader)

        found = False
        for row in rows:
            if row.get("Trial_ID") == trial_id:
                target_pct = _safe_float(row.get("Target_Fill_Pct"), 0.0) or 0.0
                row["Actual_Fill_Pct"] = round(actual_pct, 3)
                row["Fill_Error_Pct"] = round(actual_pct - target_pct, 3)
                row["Actual_Air_cm"] = "" if actual_air_cm is None else actual_air_cm
                found = True
        if not found:
            return False

        tmp = SUMMARY_FILE.with_suffix(".tmp")
        with tmp.open("w", newline="", encoding="utf-8-sig") as f:
            writer = csv.DictWriter(f, fieldnames=header, extrasaction="ignore")
            writer.writeheader()
            for row in rows:
                writer.writerow({key: row.get(key, "") for key in header})
        os.replace(tmp, SUMMARY_FILE)

    print(f"\n[REC] {trial_id} 실측 채움률 기록 | Actual={actual_pct:.1f}%")
    return True


def abort_trial() -> None:
    global _active, _pending
    with _state_lock:
        if _active is not None:
            _active["stop_event"].set()
        _active = None
        _pending = None


def get_status() -> Dict[str, Any]:
    with _state_lock:
        return {
            "active_trial": None if _active is None else _active.get("trial_id"),
            "pending_trial": None if _pending is None else _pending.get("trial_id"),
            "active": _active is not None,
            "pending": _pending is not None,
        }
