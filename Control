TRACK_HARM3_SUPPORT     = 0.5    # f/3 판정 비율. f≤900Hz면 f/3<300Hz(탐색 하한)라 정상 트랙의 우연 일치 없음
TRACK_HARM2_TOL         = 0.03   # 2f 판정 허용 오차: 2f 자리는 다른 피크와 우연히 겹치기 쉬워 엄격하게
TRACK_HARM2_SUPPORT     = 0.6    # 2f 판정 비율
