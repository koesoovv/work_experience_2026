# ════════════════════════════════════════════════════════════════════
#  GPIO 제어
# ════════════════════════════════════════════════════════════════════
def solenoid_on():
    try: solenoid.on()
    except Exception as e: print(f'\n[GPIO ON 실패] {e}')

def solenoid_off():
    try: solenoid.off()
    except Exception as e: print(f'\n[GPIO OFF 실패] {e}')

def solenoid_off_async():
    threading.Thread(target=solenoid_off, daemon=True).start()


# ════════════════════════════════════════════════════════════════════
#  구간별 파라미터 조회
# ════════════════════════════════════════════════════════════════════
def _get_zone_ema_alpha(fill_pct: float, in_final: bool) -> float:
    if 50.0 <= fill_pct < 100.0:
        key = int(fill_pct // 10) * 10
        if key in ZONE_EMA_ALPHA:
            return ZONE_EMA_ALPHA[key]
    return EMA_ALPHA_FINAL if in_final else EMA_ALPHA_NORMAL


def _get_zone_advance() -> float:
    """
    [v5.26-ZONE-FIX] advance는 TARGET_FILL_PCT 구간 기준으로 고정 조회.
    """
    key = int(TARGET_FILL_PCT // 10) * 10
    return ZONE_ADVANCE_PCT.get(key, 0.0)


# ════════════════════════════════════════════════════════════════════
#  [v5.25-DIAM-EMA] 지름 기반 EMA 스케일
# ════════════════════════════════════════════════════════════════════
def _get_diam_ema_scale(diameter: float, fill_pct: float) -> float:
    if diameter <= 0:
        return 1.0
    base = DIAM_EMA_SCALE_SMALL if diameter <= DIAM_THRESHOLD else DIAM_EMA_SCALE_LARGE
    if fill_pct >= 90.0:
        base = min(1.0, base * DIAM_EMA_SCALE_FINAL_BOOST)
    return base


# ════════════════════════════════════════════════════════════════════
#  [v5.32-DH-RECAL] H 보정량 선택
# ════════════════════════════════════════════════════════════════════
def _get_init_air_offset(init_f: float, diameter: float) -> float:
    """컵 이름 없이 초기 주파수와 추정 지름만으로 초기 공기층 보정량을 선택한다."""
    try:
        init_f   = float(init_f)
        diameter = float(diameter)
    except (TypeError, ValueError):
        return INIT_AIR_OFFSET_CM
    if init_f <= 0 or diameter <= 0:
        return INIT_AIR_OFFSET_CM
    if init_f < INIT_OFFSET_LOW_FREQ_HZ:
        return INIT_OFFSET_VERY_LOW_CM
    if init_f < INIT_OFFSET_MID_FREQ_HZ:
        return INIT_OFFSET_LARGE_MID_CM if diameter >= INIT_OFFSET_LARGE_D_CM else INIT_OFFSET_SMALL_MID_CM
    return INIT_OFFSET_HIGH_FREQ_CM


# ════════════════════════════════════════════════════════════════════
#  수학 유틸리티
# ════════════════════════════════════════════════════════════════════
def _flow_volume_to_fill_pct(q_ml_s: float, dt_s: float, diameter_cm: float, init_air_cm: float) -> float:
    """유량 Q[ml/s]가 dt초 동안 만든 채움률 증가분(%)을 계산한다."""
    try:
        q_ml_s      = float(q_ml_s)
        dt_s        = float(dt_s)
        diameter_cm = float(diameter_cm)
        init_air_cm = float(init_air_cm)
    except (TypeError, ValueError):
        return 0.0

    if q_ml_s <= 0.0 or dt_s <= 0.0 or diameter_cm <= 0.0 or init_air_cm <= 0.0:
        return 0.0

    area_cm2 = np.pi * (diameter_cm * 0.5) ** 2
    if area_cm2 <= 1e-9:
        return 0.0

    added_ml = q_ml_s * dt_s
    total_air_volume_ml = area_cm2 * init_air_cm
    return (added_ml / (total_air_volume_ml + 1e-12)) * 100.0


def loess_smooth(x, y, frac=LOESS_FRAC, degree=LOESS_DEGREE):
    n = len(x)
    if n < 4:
        return np.array(y, dtype=float)
    x = np.array(x, dtype=float)
    y = np.array(y, dtype=float)
    smoothed = np.zeros(n)
    h_width  = max(int(np.ceil(frac * n)), degree + 2)
    for i in range(n):
        dist  = np.abs(x - x[i])
        idx   = np.argsort(dist)[:h_width]
        max_d = dist[idx[-1]]
        if max_d < 1e-10:
            smoothed[i] = np.mean(y[idx])
            continue
        u = dist[idx] / max_d
        w = (1.0 - u**3)**3
        X = np.column_stack([x[idx]**p for p in range(degree + 1)])
        W = np.diag(w)
        try:
            XtW  = X.T @ W
            coef = np.linalg.lstsq(XtW @ X, XtW @ y[idx], rcond=None)[0]
            smoothed[i] = sum(coef[p] * x[i]**p for p in range(degree + 1))
        except Exception:
            smoothed[i] = y[i]
    return smoothed


def levinson_durbin(r, order):
    e = float(r[0])
    if e <= 0:
        return None
    a = np.zeros(order + 1, dtype=float)
    a[0] = 1.0
    for k in range(1, order + 1):
        acc = float(np.dot(a[1:k], r[k - 1:0:-1]))
        lam = -(r[k] + acc) / (e + 1e-12)
        if k > 1:
            a[1:k] = a[1:k] + lam * a[k - 1:0:-1]
        a[k]  = lam
        e    *= max(1.0 - lam * lam, 1e-12)
    return a


# ════════════════════════════════════════════════════════════════════
#  주파수 검출
# ════════════════════════════════════════════════════════════════════
def lpc_main_frequency(chunk, last_freq, f_min, f_max):
    x_ds  = signal.decimate(chunk.astype(float), LPC_DS_FACTOR, ftype='fir')
    sr_ds = LPC_DS_RATE
    fl    = int(LPC_FRAME_MS / 1000 * sr_ds)
    hop   = int(LPC_HOP_MS  / 1000 * sr_ds)
    frames = [x_ds[i:i + fl] for i in range(0, len(x_ds) - fl, hop)]
    if not frames:
        return 0.0
    cands = []
    for frame in frames:
        if float(np.mean(frame**2)) < LPC_MIN_ENERGY:
            continue
        frame = frame * np.hamming(len(frame))
        r = np.array([
            np.dot(frame[:len(frame) - k], frame[k:]) / len(frame)
            for k in range(LPC_ORDER + 1)
        ])
        if r[0] < 1e-12:
            continue
        a = levinson_durbin(r, LPC_ORDER)
        if a is None:
            continue
        A     = np.fft.rfft(a, n=LPC_NFFT)
        mag   = 1.0 / (np.abs(A) + 1e-12)
        freqs = np.fft.rfftfreq(LPC_NFFT, d=1.0 / sr_ds)
        mask  = (freqs >= f_min) & (freqs <= min(f_max, sr_ds / 2 - 50))
        if not np.any(mask):
            continue
        vf, vm   = freqs[mask], mag[mask]
        prom     = vm.max() * LPC_PEAK_PROM
        peaks, _ = signal.find_peaks(vm, prominence=prom, distance=4)
        if len(peaks) == 0:
            peaks = np.array([np.argmax(vm)])
        pf, pm = vf[peaks], vm[peaks]
        clean  = [i for i, f in enumerate(pf)
                  if not any(abs(f - nf) < 25.0 for nf in noise_profile)]
        if not clean:
            continue
        pf, pm = pf[clean], pm[clean]
        pm_n   = pm / (pm.max() + 1e-12)
        if last_freq > 0:
            score = pm_n - (1.0 / LPC_CONTINUITY_W) * np.abs(pf - last_freq)
            if LPC_RISE_BIAS > 0:
                score += LPC_RISE_BIAS * (pf > last_freq)
        else:
            score = pm_n
        cands.append(float(pf[np.argmax(score)]))
    return float(np.median(cands)) if cands else 0.0


def fft_backup_frequency(chunk, last_freq, f_min, f_max):
    windowed = chunk * np.hamming(len(chunk))
    fft_val  = np.abs(np.fft.rfft(windowed))
    freqs    = np.fft.rfftfreq(len(chunk), d=1.0 / SAMPLE_RATE)
    mask     = (freqs >= f_min) & (freqs <= f_max)
    if not np.any(mask):
        return 0.0
    vf, vm   = freqs[mask], fft_val[mask]
    peaks, _ = signal.find_peaks(vm, prominence=vm.max() * 0.15, distance=10)
    if len(peaks) == 0:
        return float(vf[np.argmax(vm)])
    pf, pm = vf[peaks], vm[peaks]
    clean  = [i for i, f in enumerate(pf)
              if not any(abs(f - nf) < 25.0 for nf in noise_profile)]
    if not clean:
        clean = list(range(len(pf)))
    pf, pm = pf[clean], pm[clean]
    pm_n   = pm / (pm.max() + 1e-12)
    if last_freq > 0:
        score = pm_n - (1.0 / 800.0) * np.abs(pf - last_freq)
        if LPC_RISE_BIAS > 0:
            score += LPC_RISE_BIAS * (pf > last_freq)
    else:
        score = pm_n
    return float(pf[np.argmax(score)])


def _harmonic_correct(f: float, ref: float) -> float:
    if ref <= 0 or f <= 0:
        return f
    ratio = f / ref
    if 2.7 <= ratio <= 3.3:
        return f / 3.0
    elif 1.8 <= ratio <= 2.2:
        return f / 2.0
    elif 4.7 <= ratio <= 5.3:
        return f / 5.0
    elif ratio > 2.5:
        return 0.0
    return f


def get_frequency(chunk, last_freq, f_min, f_max):
    filtered = signal.sosfilt(HP_SOS, chunk.astype(float))
    lpc_f = lpc_main_frequency(filtered, last_freq, f_min, f_max)
    lpc_f = _harmonic_correct(lpc_f, last_freq)
    if lpc_f > 0:
        return float(lpc_f)
    fft_f = fft_backup_frequency(filtered, last_freq, f_min, f_max)
    fft_f = _harmonic_correct(fft_f, last_freq)
    return float(fft_f)


# ════════════════════════════════════════════════════════════════════
#  [v5.40-TRACK] 물리 기반 주파수 트랙 필터
# ════════════════════════════════════════════════════════════════════
class _FreqTrack:
    """ℓ = c/(4f) 영역에서 '물이 차며 일정하게 줄어드는 직선'을 찾고, 칼만 필터로 추적하며 맞는 후보만 채택한다."""

    def __init__(self):
        self.reset()

    def reset(self):
        self.cand          = deque()            # (t, 후보 주파수 배열)
        self.active        = False              # 트랙 추적 중
        self.established   = False              # 한 번이라도 확정됨
        self.fallback      = False              # 기존 방식으로 전환됨
        self.x             = np.zeros(2)        # 칼만 상태 [ℓ(cm), dℓ/dt(cm/s)] @ self.tx
        self.P             = np.eye(2)          # 칼만 공분산
        self.tx            = 0.0                # 상태 기준 시각
        self.hist          = []                 # 전체 채택 (t, f)
        self.last_accept_t = 0.0
        self.lost_since    = 0.0
        self.n_acc         = 0
        self.n_rej         = 0
        self.last_log_t    = 0.0
        self.splash_noise  = []                 # 가드 구간 소음 피크(기존 방식 전환 시에만 등록)
        self.harm          = deque(maxlen=TRACK_HARMONIC_WINDOW)   # (t, f/3 후보 ℓ 또는 None, 2f 후보 ℓ 또는 None)
        self.flat_since    = None               # 칼만 기울기가 물리 하한보다 평평해진 시각
        self.rate          = deque(maxlen=TRACK_RATE_WINDOW)   # 최근 청크 채택 여부
        self.ever_confirmed = False             # 이번 급수에서 하류로 출력한 적 있음
        self.f_floor       = 0.0                # 재탐색 하한 기준: 최근 채택 중앙값의 최대(주파수는 내려갈 수 없음)
        self.v_ref         = 0.0                # 기준 기울기(cm/s, 음수). 0이면 아직 없음
        self.t_conf        = 0.0                # 트랙 확인 시각
        self.n_tone        = 0                  # 고정 톤으로 빠진 후보 수(로그용)
        self.coast_on      = False              # 트랙을 잃어 예측으로 이어가는 중
        self.coast_since   = 0.0                # 예측 시작 시각
        self.coast_t0      = 0.0                # 예측 기준점(마지막 실제 채택 시각)
        self.coast_l0      = 0.0                # 예측 기준점의 ℓ(cm)
        self.coast_v       = 0.0                # 예측 기울기(cm/s, 음수)
        self.stall_f       = 0.0                # [v5.42] 마지막 정체 구간 주파수(중앙값), 재확정 하한에 사용
        self.coasting      = False              # 이번 청크 출력이 예측값(측정 아님)
        self.reanchor_reason = 'initial'        # initial / harmonic / reacquire
        self.confirmed     = False              # 하류로 출력 중
        self.n_since       = 0                  # (재)확정·배음 이동 이후 채택 수
        self.reanchor_pending = False           # 다음 출력 때 하류 상태 재설정 필요

    def predict(self, t: float) -> float:
        """시각 t의 ℓ 예측(cm). 과거 시각(초기 주파수 기준 시각 등)도 같은 직선으로 계산."""
        return float(self.x[0] + self.x[1] * (t - self.tx))

    def _propagate(self, t: float):
        dt = t - self.tx
        F  = np.array([[1.0, dt], [0.0, 1.0]])
        q  = TRACK_ACCEL_NOISE * abs(dt)
        Qn = q * np.array([[dt * dt / 3.0, dt / 2.0], [dt / 2.0, 1.0]])
        return F @ self.x, F @ self.P @ F.T + Qn

    @staticmethod
    def meas_var(l_cm: float) -> float:
        return max(TRACK_MEAS_SIGMA_CM, TRACK_MEAS_SIGMA_REL * l_cm) ** 2


_track = _FreqTrack()


def _track_candidates(chunk) -> np.ndarray:
    """청크의 FFT 피크 상위 TRACK_CAND_TOPK개(Hz). 포물선 보간으로 bin(≈10.8Hz)보다 정밀하게 추정."""
    filtered = signal.sosfilt(HP_SOS, chunk.astype(float))
    mag   = np.abs(np.fft.rfft(filtered * np.hamming(len(filtered)))) + 1e-12
    lo    = int(np.ceil(FREQ_MIN_LIMIT * len(filtered) / SAMPLE_RATE))
    hi    = int(np.floor(FREQ_MAX_LIMIT * len(filtered) / SAMPLE_RATE))
    band  = mag[lo:hi]
    if band.size < 5:
        return np.empty(0)
    peaks, _ = signal.find_peaks(band, prominence=float(np.median(band)) * TRACK_CAND_PROM, distance=2)
    if len(peaks) == 0:
        return np.empty(0)
    peaks = peaks[np.argsort(band[peaks])[::-1][:TRACK_CAND_TOPK]]
    logm  = np.log(mag)
    out   = []
    for p in peaks:
        k = lo + int(p)
        den   = logm[k - 1] - 2.0 * logm[k] + logm[k + 1]
        delta = 0.5 * (logm[k - 1] - logm[k + 1]) / den if abs(den) > 1e-12 else 0.0
        f = (k + max(-0.5, min(0.5, delta))) * SAMPLE_RATE / len(filtered)
        if not any(abs(f - nf) < 25.0 for nf in noise_profile):
            out.append(f)
    return np.array(out, dtype=float)


def _track_line_support(T, L, C, a, b):
    """직선 ℓ=a+b·t 의 탐색 게이트 안에 후보가 있는 청크 수와, 청크별 가장 가까운 후보 인덱스."""
    gate = np.maximum(TRACK_BOOT_GATE_CM, TRACK_BOOT_GATE_REL * L)
    res  = np.abs(L - (a + b * T))
    best = {}
    for i in np.flatnonzero(res <= gate):
        c = int(C[i])
        if c not in best or res[i] < res[best[c]]:
            best[c] = i
    return len(best), np.array(sorted(best.values()), dtype=int)


def _theil_sen(T, L):
    """Theil–Sen 직선(쌍별 기울기의 중앙값). 반환 (a, b): ℓ = a + b·t"""
    ii, jj = np.triu_indices(len(T), 1)
    dt = T[jj] - T[ii]
    ok = dt > 1e-6
    if not np.any(ok):
        return float(np.median(L)), 0.0
    b = float(np.median((L[jj][ok] - L[ii][ok]) / dt[ok]))
    a = float(np.median(L - b * T))
    return a, b


def _track_reacq_min_f(tr: _FreqTrack, t: float) -> float:
    """
    재확정 직선의 현재 주파수 하한(Hz), 없으면 0.
    [v5.41] 출력했던 트랙 이후: 하한(최근 채택 중앙값의 최대) × TRACK_REACQ_MIN_RATIO
    [v5.42] 정체 감지 후: 정체 주파수 × TRACK_STALL_REACQ_RATIO (정체 피크로 다시 붙지 않게)
            예측 중: 예측 주파수 × TRACK_COAST_REACQ_RATIO (예측보다 크게 뒤처진 피크로 다시 붙지 않게)
    """
    f_min = TRACK_REACQ_MIN_RATIO * tr.f_floor if tr.f_floor > 0 else 0.0
    if tr.stall_f > 0:
        f_min = max(f_min, TRACK_STALL_REACQ_RATIO * tr.stall_f)
    if tr.coast_on:
        l_c   = max(0.5, tr.coast_l0 + tr.coast_v * (t - tr.coast_t0))
        f_min = max(f_min, TRACK_COAST_REACQ_RATIO * SOUND_SPEED / (4.0 * l_c))
    return f_min


def _track_bootstrap(tr: _FreqTrack, t_now: float) -> bool:
    """최근 후보에서 물리 기울기 범위 안의 직선을 RANSAC(쌍 → 직선 → 지지 청크 수)으로 찾는다."""
    window = [(t, fs) for (t, fs) in tr.cand if t >= t_now - TRACK_BOOT_WINDOW_SEC]
    n_chunks = len(window)
    rows = [(i, t, f) for i, (t, fs) in enumerate(window) for f in fs]
    if n_chunks < TRACK_MIN_INLIER_CHUNKS or len(rows) < TRACK_MIN_INLIER_CHUNKS:
        return False
    if window[-1][0] - window[0][0] < TRACK_MIN_SPAN_SEC:
        return False
    C = np.array([r[0] for r in rows], dtype=int)
    T = np.array([r[1] for r in rows], dtype=float)
    L = SOUND_SPEED / (4.0 * np.array([r[2] for r in rows], dtype=float))

    ii, jj = np.triu_indices(len(T), 1)
    keep = (T[jj] - T[ii]) >= TRACK_MIN_PAIR_DT
    ii, jj = ii[keep], jj[keep]
    if len(ii) == 0:
        return False
    slope = (L[jj] - L[ii]) / (T[jj] - T[ii])
    keep  = (slope <= -TRACK_SLOPE_MIN_CM_S) & (slope >= -TRACK_SLOPE_MAX_CM_S)
    ii, slope = ii[keep], slope[keep]
    if len(slope) == 0:
        return False
    if len(slope) > TRACK_MAX_PAIRS:                              # 결정적 표본 추출(재현성)
        sel = np.random.default_rng(len(slope)).choice(len(slope), TRACK_MAX_PAIRS, replace=False)
        ii, slope = ii[sel], slope[sel]
    inter = L[ii] - slope * T[ii]
    f_min_line = _track_reacq_min_f(tr, t_now)
    if f_min_line > 0:                                            # [v5.41] 확인된 트랙 이후: 주파수는 내려갈 수 없음
        l_max = SOUND_SPEED / (4.0 * f_min_line)                  # 현재 시각 직선값이 하한 아래면 제외
        keep  = inter + slope * t_now <= l_max
        inter, slope = inter[keep], slope[keep]
        if len(slope) == 0:
            return False

    gate = np.maximum(TRACK_BOOT_GATE_CM, TRACK_BOOT_GATE_REL * L)
    inl  = np.abs(L[None, :] - (inter[:, None] + slope[:, None] * T[None, :])) <= gate[None, :]
    support = np.zeros(len(slope), dtype=int)
    for c in range(n_chunks):
        cols = (C == c)
        if np.any(cols):
            support += inl[:, cols].any(axis=1)
    k = int(np.argmax(support))
    n_sup, idx = _track_line_support(T, L, C, inter[k], slope[k])
    if n_sup < TRACK_MIN_INLIER_CHUNKS or n_sup < TRACK_MIN_COVERAGE * n_chunks:
        return False
    a, b = _theil_sen(T[idx], L[idx])

    # 배음 확인(청크별): 채택점 f의 같은 청크에 f/3 또는 2f 후보가 충분히 있으면 그쪽이 기본 공명
    F = SOUND_SPEED / (4.0 * L)
    for _ in range(3):
        switched = False
        for ratio, name, tol, need in ((1.0 / 3.0, '3배음', TRACK_HARM3_TOL, TRACK_HARM3_SUPPORT),
                                       (2.0, '1/2 주파수', TRACK_HARM2_TOL, TRACK_HARM2_SUPPORT)):
            hp = []
            for i in idx:
                same = np.flatnonzero(C == C[i])
                rel  = np.abs(F[same] / (F[i] * ratio) - 1.0)
                if rel.size and rel.min() <= tol:
                    hp.append(int(same[np.argmin(rel)]))
            if len(hp) >= TRACK_MIN_INLIER_CHUNKS and len(hp) >= need * n_sup:
                hp = np.array(hp, dtype=int)
                a2, b2 = _theil_sen(T[hp], L[hp])
                if not (TRACK_SLOPE_MIN_CM_S <= -b2 <= TRACK_SLOPE_MAX_CM_S):
                    continue
                if f_min_line > 0 and SOUND_SPEED / (4.0 * (a2 + b2 * t_now)) < f_min_line:
                    continue                                      # [v5.41] 하한 아래로 내려가는 교체 금지
                n2, idx2 = _track_line_support(T, L, C, a2, b2)
                if n2 < TRACK_MIN_INLIER_CHUNKS:
                    continue
                a, b, n_sup, idx = a2, b2, n2, idx2
                print(f'\n[트랙] {name} 직선을 잡아 기본 공명 직선으로 교체 (배음 관계 {len(hp)}청크)')
                switched = True
                break
        if not switched:
            break
    # 최종 직선 근처 후보로 한 번 더 강건 재적합
    n_sup, idx = _track_line_support(T, L, C, a, b)
    if n_sup < TRACK_MIN_INLIER_CHUNKS:
        return False
    a, b = _theil_sen(T[idx], L[idx])
    if not (TRACK_SLOPE_MIN_CM_S <= -b <= TRACK_SLOPE_MAX_CM_S):
        return False
    if f_min_line > 0 and SOUND_SPEED / (4.0 * (a + b * t_now)) < f_min_line:
        return False                                              # [v5.41] 재적합 후에도 하한 아래면 제외

    resid  = L[idx] - (a + b * T[idx])
    sig_l  = max(TRACK_MEAS_SIGMA_CM, float(1.4826 * np.median(np.abs(resid - np.median(resid)))))
    span   = float(T[idx].max() - T[idx].min())
    sig_v  = max(0.05, 2.0 * sig_l / max(span, 0.5))               # 기울기 불확실성(짧은 구간일수록 큼)
    tr.tx  = float(T[idx].max())
    tr.x   = np.array([a + b * tr.tx, b])
    tr.P   = np.diag([sig_l ** 2, sig_v ** 2])
    tr.hist = []                                                  # 이전(잃은) 트랙 기록은 신뢰하지 않음
    tr.harm.clear()
    tr.flat_since = None
    tr.rate.clear()
    # [v5.41] v_ref는 유지(같은 컵·같은 유량), 재탐색으로는 지우지 않음
    tr.reanchor_reason = 'reacquire' if tr.ever_confirmed else 'initial'
    tr.confirmed, tr.n_since, tr.reanchor_pending = False, 0, True
    for i in idx:
        tr.hist.append((float(T[i]), float(SOUND_SPEED / (4.0 * L[i]))))
    tr.hist.sort()
    tr.active, tr.established = True, True
    tr.last_accept_t = tr.tx
    area = FLOW_RATE / abs(b)
    print(f'\n[트랙 확정] t={t_now:.1f}s | dℓ/dt={b:.3f}±{sig_v:.2f}cm/s (지름≈{np.sqrt(4 * area / np.pi):.1f}cm 상당)'
          f' | 지지 {n_sup}/{n_chunks}청크 | f≈{SOUND_SPEED / (4 * tr.predict(t_now)):.0f}Hz')
    return True


def _downstream_reanchor(f_new: float, t: float, reason: str = 'initial') -> None:
    """
    트랙이 (재)확정되거나 기본 공명으로 옮겨진 뒤 첫 출력 시, 하류 평활 상태를 새 주파수로 재설정한다.
    이전 값으로 걸린 바닥값(peak_lock_floor·max_freq_seen)·비대칭 EMA(f_for_stop)·중앙값 버퍼가
    새 트랙을 끌어내리거나 끌어올리지 않게 한다. 이전 값으로 이미 만든 D/H 모델이 있으면 함께 초기화.
    [v5.41] D/H 모델 초기화는 배음 교정(reason='harmonic')일 때만. 재탐색('reacquire')은 같은 공명을
            다시 잡은 것이므로 모델 유지(장비 실행에서 잡음으로 재확정 → 모델 폐기 → 넘침 발생).
    """
    global last_tracked_freq, last_stable_f, freq_buffer, _prev_buf_median, _freeze_count
    global dynamic_min_limit, peak_lock_floor, max_freq_seen, _f_stop_ema
    global tracking_mode, tracking_mode_hits
    global initial_stable_freq, initial_stable_time, current_diameter, init_air_len_cm, _eff_target_air_cm
    global calibration_done, target_freq, theory_slope, theory_intercept, theory_locked, dynamic_Q
    global last_fill_pct, consecutive_stop_hits, last_model_valid, last_reject_reason
    with lock:
        prev = float(last_stable_f)
        jumped = prev > 0 and abs(f_new / prev - 1.0) > 0.15
        had_model = initial_stable_freq > 0 and jumped and reason == 'harmonic'   # [v5.41] 재탐색으로는 모델 유지
        last_tracked_freq  = f_new
        last_stable_f      = f_new
        freq_buffer        = deque([f_new])
        _prev_buf_median   = 0.0
        _freeze_count      = 0
        dynamic_min_limit  = max(FREQ_MIN_LIMIT, f_new * 0.75)
        peak_lock_floor    = f_new
        max_freq_seen      = f_new
        _f_stop_ema        = f_new
        tracking_mode      = False
        tracking_mode_hits = 0
        if had_model:                                            # 잘못된 트랙 값으로 만든 모델 폐기 → 재추정
            initial_stable_freq = 0.0
            initial_stable_time = 0.0
            init_stable_buffer.clear()
            reg_time_buffer.clear()
            reg_inv_freq_buffer.clear()
            diameter_candidates.clear()
            current_diameter   = 0.0
            init_air_len_cm    = 0.0
            _eff_target_air_cm = 3.0
            calibration_done   = False
            target_freq        = 0.0
            theory_slope       = 0.0
            theory_intercept   = 0.0
            theory_locked      = False
            dynamic_Q          = FLOW_RATE
            last_fill_pct      = 0.0
            consecutive_stop_hits = 0
            last_model_valid   = False
            last_reject_reason = 'track_reanchor'
    if jumped:
        print(f'\n[트랙] 하류 상태 재설정({reason}) {prev:.0f}→{f_new:.0f}Hz (t={t:.1f}s)'
              + (' | 이전 D/H 모델 폐기 후 재추정' if had_model else ''))


def _track_harmonic_watch(tr: _FreqTrack, cands: np.ndarray, f: float, t: float) -> None:
    """
    추적 중 채택 주파수 f의 f/3(또는 2f) 후보가 최근 청크 대부분에 있고, 그 후보들이 트랙과 같이
    움직이면(ℓ 기울기 = 트랙의 3배 또는 0.5배) 지금 트랙은 배음이므로 기본 공명으로 옮긴다.
    """
    def near(target, tol):
        if not len(cands):
            return None
        rel = np.abs(cands / target - 1.0)
        j = int(np.argmin(rel))
        return float(SOUND_SPEED / (4.0 * cands[j])) if rel[j] <= tol else None

    tr.harm.append((t, near(f / 3.0, TRACK_HARM3_TOL), near(f * 2.0, TRACK_HARM2_TOL)))
    if len(tr.harm) < TRACK_HARMONIC_WINDOW:
        return
    b_trk = float(tr.x[1])
    for col, need, slope_mult, scale, name in ((1, TRACK_HARM3_SUPPORT, 3.0, 3.0, '3배음'),
                                               (2, TRACK_HARM2_SUPPORT, 0.5, 0.5, '1/2 주파수')):
        pts = [(h[0], h[col]) for h in tr.harm if h[col] is not None]
        if len(pts) < need * len(tr.harm) or len(pts) < 5:
            continue
        _, b_h = _theil_sen(np.array([p[0] for p in pts]), np.array([p[1] for p in pts]))
        expect = b_trk * slope_mult
        if not (TRACK_SLOPE_MIN_CM_S <= -b_h <= TRACK_SLOPE_MAX_CM_S):
            continue                                             # 평평(고정 소음) 또는 비물리적 → 배음 아님
        if abs(b_h / expect - 1.0) > TRACK_HARM_SLOPE_TOL:
            continue                                             # 트랙과 같이 움직이지 않음 → 우연한 겹침
        if not (TRACK_SLOPE_MIN_CM_S <= -b_trk * scale <= TRACK_SLOPE_MAX_CM_S):
            continue
        tr.x = tr.x * scale
        tr.P = tr.P * scale * scale
        tr.harm.clear()
        tr.hist = [(th, fh / scale) for th, fh in tr.hist]       # 기록도 기본 공명 기준으로 환산
        tr.confirmed, tr.n_since, tr.reanchor_pending = False, 0, True
        tr.reanchor_reason = 'harmonic'
        tr.f_floor = tr.f_floor / scale                          # 이전 출력은 배음 기준이었으므로 하한도 환산
        tr.stall_f = tr.stall_f / scale
        tr.v_ref   = 0.0                                         # 기준 기울기 다시 학습
        tr.coast_on = False
        print(f'\n[트랙] 추적 중 {name}를 따라가고 있음 → 기본 공명으로 이동 (t={t:.1f}s,'
              f' f {f:.0f}→{f / scale:.0f}Hz, 배음 후보 기울기 {b_h:.3f} / 기대 {expect:.3f}cm/s)')
        return


def _track_learn_vref(tr: _FreqTrack, t: float) -> None:
    """
    트랙 확인 후 TRACK_VREF_LEARN_SEC가 지나면, 이 트랙의 실제 채택 기록(예측값 제외) 전체로
    기준 기울기 v_ref(Theil–Sen)를 한 번 계산해 고정. 데이터 폭이 TRACK_VREF_MIN_SPAN_SEC보다 짧으면 대기.
    """
    if tr.v_ref != 0.0 or t - tr.t_conf < TRACK_VREF_LEARN_SEC or len(tr.hist) < 20:
        return
    T = np.array([p[0] for p in tr.hist])
    if T.max() - T.min() < TRACK_VREF_MIN_SPAN_SEC:
        return
    L = SOUND_SPEED / (4.0 * np.array([p[1] for p in tr.hist]))
    _, b = _theil_sen(T, L)
    if TRACK_SLOPE_MIN_CM_S <= -b <= TRACK_SLOPE_MAX_CM_S:
        tr.v_ref = float(b)
        print(f'\n[트랙] 기준 기울기 고정 v_ref={b:.3f}cm/s (지름≈{2.0 * np.sqrt(FLOW_RATE / (-b) / np.pi):.1f}cm 상당,'
              f' 데이터 {len(T)}점·{T.max() - T.min():.1f}s, t={t:.1f}s)')


def _track_drop_tones(tr: _FreqTrack, cands: np.ndarray, t: float) -> np.ndarray:
    """
    [v5.41] 급수 중 같은 주파수에 계속 머무는 피크(정체 피크·펌프음 등 고정 톤)는 공명이 아니므로 추적 후보에서 뺀다.
    공명은 트랙 기울기만큼 움직인다(df/dt = 4f²/c·|dℓ/dt|). TRACK_TONE_SEC 동안 그 이동량이
    TRACK_TONE_TOL_HZ의 3배보다 작으면(느린 넓은 컵·저주파) 구분이 안 되므로 빼지 않는다.
    """
    if not len(cands):
        return cands
    past = [fs for (tc, fs) in list(tr.cand)[:-1] if tc >= t - TRACK_TONE_SEC]
    if len(past) < TRACK_TONE_MIN_CHUNKS:
        return cands
    v    = abs(float(tr.x[1]))
    keep = np.ones(len(cands), dtype=bool)
    for i, f in enumerate(cands):
        if 4.0 * f * f / SOUND_SPEED * v * TRACK_TONE_SEC < 3.0 * TRACK_TONE_TOL_HZ:
            continue
        hits = sum(1 for fs in past if len(fs) and float(np.min(np.abs(fs - f))) <= TRACK_TONE_TOL_HZ)
        if hits >= TRACK_TONE_SUPPORT * len(past):
            keep[i] = False
    tr.n_tone += int((~keep).sum())
    return cands[keep]


def _track_coast_slope(tr: _FreqTrack):
    """
    [v5.41] 예측에 쓸 기울기(cm/s, 음수)와 출처. D/H 모델이 확정됐으면 그 지름·유량(dℓ/dt = -Q/A),
    아니면 트랙 기준 기울기 v_ref. 둘 다 없으면 (0.0, '').
    """
    with lock:
        d_m, q_m, ok_m = float(current_diameter), float(dynamic_Q), bool(calibration_done)
    if ok_m and d_m > 0:
        v_m = -max(DYNAMIC_Q_MIN, q_m) / (np.pi * d_m * d_m / 4.0)
        if TRACK_SLOPE_MIN_CM_S <= -v_m <= TRACK_SLOPE_MAX_CM_S:
            return v_m, f'모델 D={d_m:.2f}cm·Q={max(DYNAMIC_Q_MIN, q_m):.1f}mL/s'
    if tr.v_ref < 0.0:
        return tr.v_ref, '트랙 기준 기울기'
    return 0.0, ''


def _track_lose(tr: _FreqTrack, t: float, why: str, t_anchor: float = None) -> None:
    """
    트랙을 잃음 → 재탐색. [v5.41] 하류로 출력 중이던 트랙이면 마지막 실제 채택 상태에서 예측을 시작한다
    (물은 계속 같은 유량으로 차므로 ℓ도 같은 속도로 줄어듦). 기울기는 _track_coast_slope().
    [v5.42] t_anchor: 예측 기준 시각(정체 감지 시 정체 시작 시각 — 정체 구간 값으로 기준점을 잡지 않음)
    """
    msg = ''
    if tr.confirmed and not tr.coast_on:
        v_c, src = _track_coast_slope(tr)                         # 예측 기울기는 신뢰 기준(모델·v_ref)만 사용
        if v_c < 0.0:
            # 기준점: 마지막 실제 채택 시각(또는 t_anchor). ℓ은 그 전 채택값을 기울기 v_c로 옮긴 값들의 중앙값
            # (잃기 직전 칼만 상태는 쓰레기 쪽으로 끌려가 있을 수 있음)
            t0  = float(tr.last_accept_t if t_anchor is None else t_anchor)
            pts = [(th, SOUND_SPEED / (4.0 * fh)) for th, fh in tr.hist if t0 - TRACK_COAST_FIT_SEC <= th <= t0]
            if len(pts) >= 10:
                l0 = float(np.median([lh - v_c * (th - t0) for th, lh in pts]))
            else:
                l0 = float(tr.x[0] + tr.x[1] * (t0 - tr.tx))
            tr.coast_on, tr.coast_since, tr.coast_v = True, t, v_c
            tr.coast_t0, tr.coast_l0 = t0, l0
            msg = (f' | 다시 잡을 때까지 {v_c:.3f}cm/s({src})로 예측,'
                   f' 시작 {SOUND_SPEED / (4.0 * max(0.5, l0 + v_c * (t - t0))):.0f}Hz')
    tr.active, tr.confirmed = False, False
    tr.lost_since = t
    print(f'\n[트랙] {why} → 재탐색{msg} (t={t:.1f}s)')


def _track_check_stall(tr: _FreqTrack, t: float) -> bool:
    """
    [v5.42] 정체 감지: 급수 중 공명 주파수는 멈출 수 없다. 최근 TRACK_STALL_WINDOW_SEC 동안 실제 채택값(ℓ)의 기울기가
    기준 기울기(D/H 모델·v_ref와 바로 앞 TRACK_STALL_REF_SEC 구간 중 평평한 쪽) × TRACK_STALL_RATIO 보다 평평하면
    공명이 아닌 피크(공명이 사라진 뒤 제자리에서 흔들리는 피크 등)를 따라가는 것으로 보고 트랙을 놓는다.
    예측 기준점은 정체 시작 전 데이터로 잡는다. 정체로 판단하면 True.
    """
    if t - tr.t_conf < TRACK_STALL_WINDOW_SEC:
        return False
    b_trust, src_t = _track_coast_slope(tr)                     # 신뢰 기준(D/H 모델 또는 고정된 v_ref)이 있어야 판정
    if b_trust >= 0.0:
        return False
    t_s = t - TRACK_STALL_WINDOW_SEC
    win = [(th, SOUND_SPEED / (4.0 * fh)) for th, fh in tr.hist if th >= t_s]
    if len(win) < TRACK_STALL_MIN_POINTS or win[-1][0] - win[0][0] < 0.8 * TRACK_STALL_WINDOW_SEC:
        return False
    ref = [(th, SOUND_SPEED / (4.0 * fh)) for th, fh in tr.hist if t_s - TRACK_STALL_REF_SEC <= th < t_s]
    b_ref, src = b_trust, src_t
    if len(ref) >= TRACK_STALL_MIN_POINTS and ref[-1][0] - ref[0][0] >= 0.6 * TRACK_STALL_REF_SEC:
        _, b_loc = _theil_sen(np.array([p[0] for p in ref]), np.array([p[1] for p in ref]))
        if b_loc > b_ref:                                         # 둘 중 평평한 쪽(오판 방지, 위가 넓은 컵은 직전 구간이 더 평평)
            b_ref, src = min(b_loc, TRACK_STALL_REF_MIN * b_trust), '직전 구간'   # 단, 신뢰 기준의 0.6배보다 평평하게는 안 함
    if not (TRACK_SLOPE_MIN_CM_S <= -b_ref <= TRACK_SLOPE_MAX_CM_S):
        return False
    _, b_w = _theil_sen(np.array([p[0] for p in win]), np.array([p[1] for p in win]))
    if b_w <= TRACK_STALL_RATIO * b_ref:                          # 기준의 절반 이상 속도로 줄고(오르고) 있음 → 정상
        return False
    tr.stall_f = float(SOUND_SPEED / (4.0 * np.median([p[1] for p in win])))
    _track_lose(tr, t, f'주파수 정체(최근 {TRACK_STALL_WINDOW_SEC:.0f}s 기울기 {b_w:.3f} / {src} {b_ref:.3f}cm/s,'
                       f' 급수 중 공명은 멈출 수 없음)', t_anchor=t_s)
    return True


def _track_coast_f(tr: _FreqTrack, t: float) -> float:
    """[v5.41] 예측 중이면 기준점(마지막 실제 채택)에서 coast_v로 이어간 주파수(Hz), 아니면 0.0."""
    if not tr.coast_on:
        return 0.0
    tr.coasting = True
    return float(SOUND_SPEED / (4.0 * max(0.5, tr.coast_l0 + tr.coast_v * (t - tr.coast_t0))))


def _track_step(chunk, t: float) -> float:
    """
    청크 1개 처리. 트랙에 맞는 주파수(Hz)를 반환, 쓰레기·트랙 미확정이면 0.0.
    [v5.41] 출력하던 트랙을 잃으면 다시 잡아 확인될 때까지 예측값을 반환(tr.coasting=True, 최대 TRACK_COAST_MAX_SEC).
    """
    tr = _track
    tr.coasting = False
    cands = _track_candidates(chunk)
    tr.cand.append((t, cands))
    while tr.cand and tr.cand[0][0] < t - TRACK_BOOT_WINDOW_SEC:
        tr.cand.popleft()

    if t - tr.last_log_t >= TRACK_LOG_INTERVAL:
        state = '추적' if tr.active else ('재탐색' if tr.established else '탐색')
        print(f'\n[트랙] t={t:.1f}s {state} | 채택 {tr.n_acc} / 거부 {tr.n_rej} / 고정톤 {tr.n_tone}'
              + (f' | f̂={SOUND_SPEED / (4 * tr.predict(t)):.0f}Hz dℓ/dt={tr.x[1]:.3f}' if tr.active else '')
              + (f' | 예측 진행 중 {_track_coast_f(tr, t):.0f}Hz' if tr.coast_on else ''))
        tr.coasting = False
        tr.last_log_t = t

    if not tr.active:
        if tr.coast_on and t - tr.coast_since > TRACK_COAST_MAX_SEC:
            tr.coast_on = False
            print(f'\n[트랙] {TRACK_COAST_MAX_SEC:.0f}s 동안 공명을 다시 못 잡음 → 예측 중단 (t={t:.1f}s)')
        lost_too_long = tr.established and not tr.coast_on and (t - tr.lost_since) > TRACK_REACQUIRE_SEC
        if (not tr.established and t >= TRACK_FALLBACK_SEC) or lost_too_long:
            tr.fallback = True
            with lock:
                for f_n in tr.splash_noise:                      # 기존 방식과 같게 가드 구간 소음 등록
                    if not any(abs(f_n - nf) < 30 for nf in noise_profile):
                        noise_profile.append(f_n)
            print(f'\n[트랙] {"잃은 뒤 재확정 실패" if lost_too_long else "트랙 미확정"} → 기존(v5.32) 검출 방식으로 전환'
                  f' (t={t:.1f}s)')
            return 0.0
        _track_bootstrap(tr, t)
        return _track_coast_f(tr, t)

    # 칼만 예측 → 게이트 안 가장 가까운 후보 채택 → 갱신
    x_p, P_p = tr._propagate(t)
    l_hat    = float(x_p[0])
    S        = float(P_p[0, 0]) + _FreqTrack.meas_var(l_hat)
    g        = min(TRACK_GATE_MAX_REL * l_hat, max(TRACK_GATE_MIN_REL * l_hat, TRACK_GATE_SIGMA * np.sqrt(S)))
    cands    = _track_drop_tones(tr, cands, t)                   # [v5.41] 고정 톤 제거
    if len(cands) and l_hat > 0:
        dist = np.abs(SOUND_SPEED / (4.0 * cands) - l_hat)
        j = int(np.argmin(dist))
        if dist[j] <= g:
            f  = float(cands[j])
            z  = SOUND_SPEED / (4.0 * f)
            K  = P_p[:, 0] / S
            tr.x  = x_p + K * (z - l_hat)
            tr.P  = P_p - np.outer(K, P_p[0, :])
            if -tr.x[1] < TRACK_SLOPE_MIN_CM_S:                    # 물리 하한보다 평평 = 고정 소음을 따라가는 중일 수 있음
                tr.flat_since = t if tr.flat_since is None else tr.flat_since
            else:
                tr.flat_since = None
            tr.x[1] = -min(TRACK_SLOPE_MAX_CM_S, max(TRACK_SLOPE_MIN_CM_S, -tr.x[1]))   # 물리 범위 유지
            tr.tx = t
            if tr.flat_since is not None and t - tr.flat_since >= TRACK_FLAT_SEC:
                _track_lose(tr, t, f'{TRACK_FLAT_SEC:.0f}s 넘게 주파수가 오르지 않음(고정 소음 추정)')
                return _track_coast_f(tr, t)
            tr.hist.append((t, f))
            tr.last_accept_t = t
            tr.n_acc += 1
            tr.rate.append(True)
            tr.n_since += 1
            _track_harmonic_watch(tr, cands, f, t)
            if not tr.confirmed and tr.n_since >= TRACK_CONFIRM_CHUNKS:
                tr.confirmed = True
                tr.t_conf = t
                print(f'\n[트랙] 기본 공명 확인 → 출력 시작 (t={t:.1f}s, f={f:.0f}Hz)')
            if not tr.confirmed:
                return _track_coast_f(tr, t)                     # 다시 잡은 트랙 확인 전: 예측 유지
            if tr.coast_on:
                print(f'\n[트랙] 공명 다시 잡음 → 예측 종료 (t={t:.1f}s, 측정 {f:.0f}Hz / 예측 {_track_coast_f(tr, t):.0f}Hz)')
                tr.coast_on = False
            _track_learn_vref(tr, t)
            if tr.reanchor_pending:
                tr.reanchor_pending = False
                _downstream_reanchor(f, t, tr.reanchor_reason)
            tr.ever_confirmed = True
            f_med = float(np.median([fh for _, fh in tr.hist[-TRACK_FLOOR_MEDIAN_N:]]))
            tr.f_floor = max(tr.f_floor, f_med)                  # 한 번 튄 값으로 하한이 올라가지 않게 중앙값
            if _track_check_stall(tr, t):                         # [v5.42] 정체 → 트랙 놓고 예측으로
                return _track_coast_f(tr, t)
            return f
    tr.n_rej += 1
    tr.rate.append(False)
    if len(tr.rate) >= TRACK_RATE_WINDOW and sum(tr.rate) / len(tr.rate) < TRACK_MIN_ACCEPT_RATE:
        _track_lose(tr, t, f'최근 채택률 {sum(tr.rate) / len(tr.rate) * 100:.0f}% (<{TRACK_MIN_ACCEPT_RATE * 100:.0f}%) → 가짜 트랙으로 보고')
        return _track_coast_f(tr, t)
    if t - tr.last_accept_t > TRACK_LOST_SEC:
        _track_lose(tr, t, f'{TRACK_LOST_SEC:.1f}s 동안 맞는 주파수 없음')
    return _track_coast_f(tr, t)


def _detect_v532(chunk, filling_elapsed: float, _last: float, _init: float, _last_s: float) -> float:
    """
    [v5.40-TRACK] 기존(v5.32) 3·4단계 검출을 그대로 옮긴 함수. 트랙 필터를 못 쓸 때(전환 후) 사용.
    반환: 검출 주파수(Hz), 범위 밖·실패면 0.0
    """
    global dynamic_min_limit

    # ── 3단계: 탐색 범위 결정 ────────────────────────────────────
    if filling_elapsed < 3.5:
        current_ceil  = EARLY_CEIL_HZ
        current_floor = dynamic_min_limit
    elif tracking_mode:
        current_ceil  = min(FREQ_MAX_LIMIT, _last + TRACKING_BAND_HZ)
        current_floor = max(dynamic_min_limit, max_freq_seen * TRACKING_FLOOR_RATIO)
    else:
        base = _last if _last > 0 else (_last_s if _last_s > 0 else _init)
        current_ceil  = min(FREQ_MAX_LIMIT, base + 1500.0) if base > 0 else FREQ_MAX_LIMIT
        current_floor = dynamic_min_limit

    if not tracking_mode and _last > 400:
        new_floor = _last * 0.75
        if new_floor > dynamic_min_limit:
            dynamic_min_limit = new_floor

    if _init > 0 and not tracking_mode:
        init_floor = _init * 0.85
        if init_floor > dynamic_min_limit:
            dynamic_min_limit = init_floor

    with lock:
        _tf = float(target_freq)
    if _tf > 0 and dynamic_min_limit > _tf * 0.85:
        dynamic_min_limit = _tf * 0.85

    # ── 4단계: 주파수 검출 ───────────────────────────────────────
    with lock:
        _init_confirmed = (initial_stable_freq > 0)

    if not _init_confirmed:
        filtered   = signal.sosfilt(HP_SOS, chunk.astype(float))
        detected_f = fft_backup_frequency(filtered, _last, current_floor, current_ceil)
        detected_f = _harmonic_correct(detected_f, _last)
    else:
        detected_f = get_frequency(chunk, _last, current_floor, current_ceil)

    if detected_f < current_floor or detected_f == 0:
        detected_f = 0.0
    if filling_elapsed < 3.5 and detected_f > EARLY_CEIL_HZ:
        detected_f = 0.0
    return float(detected_f)


# ════════════════════════════════════════════════════════════════════
#  회귀 기반 D 추정
# ════════════════════════════════════════════════════════════════════
def robust_slope_loess_lsm(times, inv_freqs):
    if len(times) < 12:
        return None, 0.0, 0.0
    x = np.array(times,     dtype=float)
    y = np.array(inv_freqs, dtype=float)
    y_smooth = loess_smooth(x, y, frac=LOESS_FRAC, degree=LOESS_DEGREE)
    try:
        p    = np.polyfit(x, y_smooth, 1)
        res  = np.abs(y_smooth - (p[0] * x + p[1]))
        mask = res <= np.percentile(res, 75)
        if mask.sum() < 8:
            return None, 0.0, 0.0
        slope, intercept = np.polyfit(x[mask], y_smooth[mask], 1)
        if slope >= 0 or abs(slope) < MIN_SLOPE_CUTOFF:
            return None, 0.0, 0.0
        y_pred = slope * x[mask] + intercept
        ss_res = np.sum((y_smooth[mask] - y_pred)**2)
        ss_tot = np.sum((y_smooth[mask] - y_smooth[mask].mean())**2)
        r2     = 1.0 - ss_res / (ss_tot + 1e-12)
        return float(slope), float(intercept), float(r2)
    except Exception:
        return None, 0.0, 0.0


def theory_freq(t: float) -> float:
    if not theory_locked:
        return 0.0
    denom = theory_slope * t + theory_intercept
    if denom <= 1e-6:
        return 0.0
    return 1.0 / denom


# ════════════════════════════════════════════════════════════════════
#  회귀 워커 스레드
# ════════════════════════════════════════════════════════════════════
def _regression_worker():
    global current_diameter, target_freq, calibration_done
    global theory_slope, theory_intercept, theory_locked
    global init_air_len_cm, last_r2, diameter_candidates
    global _eff_target_air_cm, dynamic_Q
    global last_d_locked_cm, last_d_candidate_median, last_d_candidate_mad
    global last_init_air_by_initfreq_cm, last_init_air_by_regression_cm, last_init_air_locked_cm
    global last_model_valid, last_reject_reason, last_control_profile

    while True:
        _reg_event.wait(timeout=1.0)
        _reg_event.clear()

        with lock:
            if not is_filling:
                continue
            _filling_elapsed = time.time() - filling_start_time - NOISE_CALIBRATION_TIME
            times     = list(reg_time_buffer)
            inv_freqs = list(reg_inv_freq_buffer)
            _init_f   = float(initial_stable_freq)
            _cur_d    = float(current_diameter)
            _cand_cnt = len(diameter_candidates)
            _dyn_q    = float(dynamic_Q)
            _diam_full = (_cand_cnt >= DIAM_CAND_MAXLEN) or \
                         (_cand_cnt >= DIAM_CAND_MIN and _filling_elapsed > DIAM_CALC_END_TIME)

        if _diam_full:
            continue
        if len(times) <= REG_MIN_POINTS:
            continue

        s_a, s_b, r_sq = robust_slope_loess_lsm(times, inv_freqs)

        if s_a is not None:
            if _cur_d > 0:
                q_implied = abs(s_a) * np.pi * SOUND_SPEED * _cur_d**2 / 16
                print(f'\n[회귀] slope={s_a:.6f} | r²={r_sq:.4f}'
                      f' | 역산Q={q_implied:.1f}ml/s | dynQ={_dyn_q:.1f}ml/s')
            else:
                print(f'\n[회귀] slope={s_a:.6f} | r²={r_sq:.4f}')

        with lock:
            if s_a is not None and r_sq > THEORY_LOCK_R2 and not theory_locked:
                theory_slope     = s_a
                theory_intercept = s_b
                theory_locked    = True
                print(f'\n[★ 이론 곡선 잠금] slope={s_a:.6f} r²={r_sq:.3f}')

        if s_a is None or abs(s_a) <= 1e-9:
            continue

        if abs(s_a) < 0.000035:
            r2_threshold = 0.88
        elif abs(s_a) < 0.000055:
            r2_threshold = 0.92
        else:
            r2_threshold = 0.95

        if r_sq <= r2_threshold:
            with lock:
                last_r2 = r_sq
            continue

        # ── [v5.25-DYN-Q] r² 통과 시 dynamic_Q EMA 갱신 ─────────────
        if _cur_d > 0 and _cand_cnt >= DIAM_CAND_MIN:
            q_implied = abs(s_a) * np.pi * SOUND_SPEED * _cur_d**2 / 16
            if DYNAMIC_Q_MIN <= q_implied <= DYNAMIC_Q_MAX:
                new_dyn_q = _dyn_q * (1 - DYNAMIC_Q_EMA_ALPHA) + q_implied * DYNAMIC_Q_EMA_ALPHA
                new_dyn_q = max(DYNAMIC_Q_MIN, min(DYNAMIC_Q_MAX, new_dyn_q))
                with lock:
                    dynamic_Q = new_dyn_q
                _dyn_q = new_dyn_q
                print(f'\n[DYN-Q] Q={_dyn_q:.2f}ml/s (역산={q_implied:.1f})')

        # [v5.32-DH-RECAL] D 역산에 보정된 유효 유량 사용
        effective_Q = DIAMETER_EST_FLOW_RATE
        temp_D = np.sqrt(16 * effective_Q / (np.pi * SOUND_SPEED * abs(s_a)))

        if abs(s_a) < 0.000030:
            auto_scale = 0.90
        elif abs(s_a) < 0.000045:
            auto_scale = 0.95
        else:
            auto_scale = 1.0

        temp_D *= DIAMETER_SCALE * auto_scale

        if not (5.0 < temp_D < 10.0):
            continue

        with lock:
            cand_list = list(diameter_candidates)

        if len(cand_list) >= 3:
            cur_med = float(np.median(cand_list))
            outlier = abs(temp_D - cur_med) / cur_med > DIAM_OUTLIER_RATIO
        else:
            outlier = False
            cur_med = temp_D

        if outlier:
            print(f'\n[D이상치] temp_D={temp_D:.2f}cm (중앙값={cur_med:.2f}cm ±30%, 무시)')
            continue

        with lock:
            last_r2 = r_sq
            diameter_candidates.append(temp_D)

            _new_cnt      = len(diameter_candidates)
            _elapsed_now  = time.time() - filling_start_time - NOISE_CALIBRATION_TIME
            diam_full_now = (_new_cnt >= DIAM_CAND_MAXLEN) or \
                            (_new_cnt >= DIAM_CAND_MIN and _elapsed_now > DIAM_CALC_END_TIME)

            cand_arr = np.array(list(diameter_candidates), dtype=float)
            med_D = float(np.median(cand_arr))
            mad_D = float(np.median(np.abs(cand_arr - med_D))) if len(cand_arr) > 0 else 0.0
            last_d_candidate_median = med_D
            last_d_candidate_mad    = mad_D
            if current_diameter == 0:
                current_diameter = med_D
            else:
                current_diameter = current_diameter * DIAM_EMA_KEEP + med_D * DIAM_EMA_NEW
            _cur_d = float(current_diameter)
            last_d_locked_cm = _cur_d

            if _new_cnt == 1:
                _cup_type  = '소형 컵 (D≤8.0cm)' if _cur_d <= DIAM_THRESHOLD else '대형 컵 (D>8.0cm)'
                _scale_val = _get_diam_ema_scale(_cur_d, 0.0)
                print(f'\n[v5.25] 용기 판별: {_cup_type} | D={_cur_d:.2f}cm | EMA scale={_scale_val:.2f}')

            if init_air_len_cm == 0.0 and _init_f > 0 and _cur_d > 0:
                h_offset = _get_init_air_offset(_init_f, _cur_d)
                h_init   = SOUND_SPEED / (4 * _init_f) - END_CORRECTION_K * _cur_d
                h_reg    = SOUND_SPEED * theory_intercept / 4.0 - END_CORRECTION_K * _cur_d \
                           if (theory_locked and theory_intercept > 0) else 0.0

                h_init_corr = h_init + h_offset
                h_reg_corr  = h_reg  + h_offset if h_reg > 0 else 0.0

                last_init_air_by_initfreq_cm   = h_init_corr
                last_init_air_by_regression_cm = h_reg_corr

                if h_reg_corr > 0 and abs(h_reg_corr - h_init_corr) <= INIT_AIR_BLEND_TOL_CM:
                    est = h_init_corr * (1.0 - INIT_AIR_REG_BLEND) + h_reg_corr * INIT_AIR_REG_BLEND
                else:
                    est = h_init_corr

                if 5.5 <= est <= 16.0:
                    init_air_len_cm         = est
                    last_init_air_locked_cm = est
                    last_model_valid        = True
                    last_reject_reason      = 'ok'
                    _eff_target_air_cm = max(0.5, est * (1.0 - TARGET_FILL_PCT / 100.0))
                    print(f'\n[★ 용기 높이 확정] {est:.2f}cm'
                          f' | offset:{h_offset:.2f}cm'
                          f' → 목표 공기층 {_eff_target_air_cm:.2f}cm ({TARGET_FILL_PCT:.0f}%)')
                else:
                    last_model_valid   = False
                    last_reject_reason = 'init_air_out_of_range'

            target_L_eff = _eff_target_air_cm + END_CORRECTION_K * _cur_d
            new_tf = SOUND_SPEED / (4 * target_L_eff)
            if target_freq == 0:
                target_freq = new_tf
            else:
                change_ratio = abs(new_tf - target_freq) / target_freq
                if change_ratio <= TARGET_MAX_CHANGE_RATIO:
                    target_freq = new_tf
            calibration_done = True

            if diam_full_now:
                print(f'\n[★ 지름 확정] D={_cur_d:.3f}cm | dynQ={dynamic_Q:.1f}ml/s'
                      f' | cand={_new_cnt} | t={_elapsed_now:.1f}s')


_reg_worker_thread = threading.Thread(target=_regression_worker, daemon=True)
_reg_worker_thread.start()


# ════════════════════════════════════════════════════════════════════
#  급수 시작/종료
# ════════════════════════════════════════════════════════════════════
def start_filling_local() -> None:
    global is_filling, filling_start_time, calibration_done
    global freq_buffer, reg_time_buffer, reg_inv_freq_buffer
    global diameter_candidates, history_time, history_freq
    global history_detected_freq, history_stop_freq
    global last_tracked_freq, consecutive_loss_count, consecutive_stop_hits
    global current_diameter, target_freq, initial_stable_freq, initial_stable_time
    global request_finish, last_stable_f, last_current_air, last_fill_pct
    global dynamic_min_limit, noise_profile, noise_floor_level
    global max_freq_seen, tracking_mode, tracking_mode_hits
    global theory_slope, theory_intercept, theory_locked
    global _prev_buf_median, _freeze_count
    global last_r2, spike_blocked_count, history_freq_snapshot
    global init_air_len_cm, _eff_target_air_cm
    global peak_lock_floor, init_stable_buffer
    global dynamic_Q, _f_stop_ema
    global last_stop_elapsed_sec, last_raw_stop_freq, last_decision_freq, last_decision_fill_pct
    global last_detected_f, last_f_for_stop
    global last_d_locked_cm, last_d_candidate_median, last_d_candidate_mad
    global last_init_air_by_initfreq_cm, last_init_air_by_regression_cm, last_init_air_locked_cm
    global last_model_valid, last_reject_reason, last_control_profile
    global _stag_buffer, _stag_last_log
    global bridge_active, bridge_start_elapsed, bridge_start_fill_pct, bridge_pred_fill_pct
    global bridge_start_q, bridge_start_freq, bridge_eta_sec, bridge_last_log

    with lock:
        is_filling              = True
        filling_start_time      = time.time()
        calibration_done        = False
        freq_buffer             = deque()
        _f_stop_ema             = 0.0    # [v5.29-ASYM-EMA]
        last_stop_elapsed_sec   = 0.0
        last_raw_stop_freq      = 0.0
        last_decision_freq      = 0.0
        last_decision_fill_pct  = 0.0
        last_d_locked_cm        = 0.0
        last_d_candidate_median = 0.0
        last_d_candidate_mad    = 0.0
        last_init_air_by_initfreq_cm   = 0.0
        last_init_air_by_regression_cm = 0.0
        last_init_air_locked_cm        = 0.0
        last_model_valid        = False
        last_reject_reason      = 'not_calibrated'
        last_control_profile    = 'default'
        reg_time_buffer.clear()
        reg_inv_freq_buffer.clear()
        diameter_candidates.clear()
        history_time            = []
        history_freq            = []
        history_detected_freq   = []
        history_stop_freq       = []
        last_tracked_freq       = 0.0
        consecutive_loss_count  = 0
        consecutive_stop_hits   = 0
        initial_stable_freq     = 0.0
        initial_stable_time     = 0.0
        current_diameter        = 0.0
        target_freq             = 0.0
        request_finish          = False
        last_stable_f           = 0.0
        last_detected_f         = 0.0
        last_f_for_stop         = 0.0
        last_current_air        = 0.0
        last_fill_pct           = 0.0
        dynamic_min_limit       = FREQ_MIN_LIMIT
        noise_profile           = []
        noise_floor_level       = 0.0
        dynamic_Q               = FLOW_RATE
        max_freq_seen           = 0.0
        tracking_mode           = False
        tracking_mode_hits      = 0
        theory_slope            = 0.0
        theory_intercept        = 0.0
        theory_locked           = False
        _prev_buf_median        = 0.0
        _freeze_count           = 0
        last_r2                 = 0.0
        spike_blocked_count     = 0
        history_freq_snapshot   = []
        init_air_len_cm         = 0.0
        _eff_target_air_cm      = 3.0
        peak_lock_floor         = 0.0
        init_stable_buffer      = deque(maxlen=10)
        _stag_buffer            = deque(maxlen=40)   # [v5.31-STAG-LOG]
        _stag_last_log          = 0.0
        bridge_active           = False
        bridge_start_elapsed    = 0.0
        bridge_start_fill_pct   = 0.0
        bridge_pred_fill_pct    = 0.0
        bridge_start_q          = 0.0
        bridge_start_freq       = 0.0
        bridge_eta_sec          = 0.0
        bridge_last_log         = 0.0
        _track.reset()                                           # [v5.40-TRACK]
    print('\n>>> [1단계] 배경 소음 측정 (3초)...')


def stop_filling_local(save_result: bool) -> None:
    global is_filling, request_finish, history_freq_snapshot
    global last_stop_elapsed_sec
    with lock:
        history_freq_snapshot = list(history_freq)
        last_stop_elapsed_sec = max(0.0, time.time() - filling_start_time - NOISE_CALIBRATION_TIME)
        is_filling = False
        if save_result:
            request_finish = True
    close_audio_stream_async(delay_sec=0.35)                    # 급수 종료 후 분석용 오디오 스트림을 확실히 해제
    print('\n>>> 물 주입 종료.')


# ════════════════════════════════════════════════════════════════════
#  오디오 콜백
# ════════════════════════════════════════════════════════════════════
def audio_callback(indata, frames, time_info, status):
    global is_filling, filling_start_time, calibration_done
    global target_freq, current_diameter
    global freq_buffer, reg_time_buffer, reg_inv_freq_buffer
    global diameter_candidates, history_time, history_freq
    global history_detected_freq, history_stop_freq
    global last_tracked_freq, consecutive_loss_count, consecutive_stop_hits
    global request_finish, last_stable_f, last_current_air, last_fill_pct
    global initial_stable_freq, initial_stable_time
    global last_print_time, dynamic_min_limit, noise_profile, noise_floor_level
    global STOP_TRIGGER_COUNT, CONTROL_START_TIME, FREQ_MAX_LIMIT, EARLY_CEIL_HZ
    global max_freq_seen, tracking_mode, tracking_mode_hits
    global theory_slope, theory_intercept, theory_locked
    global _prev_buf_median, _freeze_count
    global last_r2, spike_blocked_count, history_freq_snapshot
    global init_air_len_cm, _eff_target_air_cm
    global peak_lock_floor, init_stable_buffer
    global dynamic_Q, _f_stop_ema
    global last_stop_elapsed_sec, last_raw_stop_freq, last_decision_freq, last_decision_fill_pct
    global last_detected_f, last_f_for_stop
    global last_d_locked_cm, last_d_candidate_median, last_d_candidate_mad
    global last_init_air_by_initfreq_cm, last_init_air_by_regression_cm, last_init_air_locked_cm
    global last_model_valid, last_reject_reason, last_control_profile
    global _stag_buffer, _stag_last_log
    global bridge_active, bridge_start_elapsed, bridge_start_fill_pct, bridge_pred_fill_pct
    global bridge_start_q, bridge_start_freq, bridge_eta_sec, bridge_last_log

    if not is_filling:
        return

    chunk = indata.flatten().astype(float)
    if np.max(np.abs(chunk)) < 0.01:
        return

    try:
        current_time = time.time()
        with lock:
            elapsed = current_time - filling_start_time

        # ── 1단계: 배경 소음 수집 + 노이즈 플로어 측정 ──────────────
        if elapsed < NOISE_CALIBRATION_TIME:
            windowed = chunk * np.hamming(len(chunk))
            fft_val  = np.abs(np.fft.rfft(windowed))
            freqs    = np.fft.rfftfreq(len(chunk), d=1.0 / SAMPLE_RATE)
            mask     = (freqs >= 100) & (freqs <= 2000)
            if np.any(mask):
                vf, vm   = freqs[mask], fft_val[mask]
                peaks, _ = signal.find_peaks(vm, prominence=vm.max() * 0.2)
                with lock:
                    for p in peaks:
                        f_n = float(vf[p])
                        if not any(abs(f_n - nf) < 20 for nf in noise_profile):
                            noise_profile.append(f_n)
                pctile_val = float(np.percentile(fft_val[mask], NOISE_FLOOR_PCTILE))
                with lock:
                    if pctile_val > noise_floor_level:
                        noise_floor_level = pctile_val
            return

        filling_elapsed = elapsed - NOISE_CALIBRATION_TIME

        # [v5.40-TRACK] 트랙 필터 사용 여부 (전환 전까지)
        track_on = TRACK_ENABLE and not _track.fallback

        # ── 2단계: SPLASH 구간 펌프 소음 보완 ──────────────────────
        #   트랙 모드: 소음 피크는 따로 모아 두기만 하고(기존 방식 전환 시에만 등록), 검출은 계속한다.
        if filling_elapsed < SPLASH_GUARD_TIME:
            windowed = chunk * np.hamming(len(chunk))
            fft_val  = np.abs(np.fft.rfft(windowed))
            freqs    = np.fft.rfftfreq(len(chunk), d=1.0 / SAMPLE_RATE)
            mask     = (freqs >= 100) & (freqs < 700)
            if np.any(mask):
                vf, vm   = freqs[mask], fft_val[mask]
                peaks, _ = signal.find_peaks(vm, prominence=vm.max() * 0.3)
                target_list = _track.splash_noise if track_on else noise_profile
                with lock:
                    for p in peaks:
                        f_n = float(vf[p])
                        if not any(abs(f_n - nf) < 30 for nf in target_list):
                            target_list.append(f_n)
            if not track_on or filling_elapsed < WATER_SETTLE_SEC:
                return

        with lock:
            _last   = float(last_tracked_freq)
            _init   = float(initial_stable_freq)
            _last_s = float(last_stable_f)
            _nfl    = float(noise_floor_level)

        # ── SNR 체크 ─────────────────────────────────────────────────
        if _nfl > 0:
            windowed_snr = chunk * np.hamming(len(chunk))
            fft_snr      = np.abs(np.fft.rfft(windowed_snr))
            freqs_snr    = np.fft.rfftfreq(len(chunk), d=1.0 / SAMPLE_RATE)
            snr_mask     = (freqs_snr >= FREQ_MIN_LIMIT) & (freqs_snr <= FREQ_MAX_LIMIT)
            if np.any(snr_mask):
                peak_mag = float(fft_snr[snr_mask].max())
                if peak_mag < _nfl * SNR_THRESHOLD:
                    return

        # ── [v5.40-TRACK] 트랙 필터: 직선에 맞는 주파수만 채택, 나머지(쓰레기)는 0 ──
        if track_on:
            detected_f = _track_step(chunk, filling_elapsed)
        else:
            detected_f = _detect_v532(chunk, filling_elapsed, _last, _init, _last_s)

        if detected_f == 0.0:
            consecutive_loss_count += 1
            if not tracking_mode:
                dynamic_min_limit = max(FREQ_MIN_LIMIT, dynamic_min_limit * 0.97)
            if consecutive_loss_count > 10:
                with lock:
                    if last_stable_f > 0:
                        last_tracked_freq = float(last_stable_f)
                    elif initial_stable_freq > 0:
                        last_tracked_freq = float(initial_stable_freq)
                    else:
                        last_tracked_freq *= 0.9
            return

        consecutive_loss_count = 0
        raw_f_for_reg = float(detected_f)   # EMA 이전 raw 주파수

        # 변경
        if _f_stop_ema <= 0:
            _f_stop_ema = raw_f_for_reg
        elif raw_f_for_reg >= _f_stop_ema:
            _f_stop_ema = (_f_stop_ema * (1 - FSCORE_ALPHA_UP)
                           + raw_f_for_reg * FSCORE_ALPHA_UP)
        else:
            if not tracking_mode:                                # 트래킹 전: 조금 내려감
                _f_stop_ema = (_f_stop_ema * (1 - FSCORE_ALPHA_DOWN)
                               + raw_f_for_reg * FSCORE_ALPHA_DOWN)
            # 트래킹 모드 진입 후: 하강 무시 → 현재값 유지 (단조 증가)

        f_for_stop_plot = _f_stop_ema   # 그래프 비교용

        # ── [v5.30-PKFLOOR] spike 감지 플래그 ───────────────────────
        # raw_f_for_reg가 직전 추적값의 SPIKE_RATIO_THRESHOLD 배 초과 → spike
        _is_spike = (_last > 0 and raw_f_for_reg > _last * SPIKE_RATIO_THRESHOLD)

        # ── 5단계: EMA 스무딩 ────────────────────────────────────────
        with lock:
            _cur_d_snap   = float(current_diameter)
            _calib_snap   = bool(calibration_done)
            _eff_tgt      = float(_eff_target_air_cm)
            _fill_pct_now = float(last_fill_pct)

        if _calib_snap and _cur_d_snap > 0 and _last_s > 0:
            L_now    = SOUND_SPEED / (4 * _last_s) - END_CORRECTION_K * _cur_d_snap
            in_final = (L_now < _eff_tgt * FINAL_APPROACH_MULT)
        else:
            in_final = False

        if _calib_snap and _fill_pct_now >= 50.0:
            alpha_det = _get_zone_ema_alpha(_fill_pct_now, in_final)
        else:
            alpha_det = EMA_ALPHA_FINAL if in_final else EMA_ALPHA_NORMAL

        if _cur_d_snap > 0:
            diam_scale = _get_diam_ema_scale(_cur_d_snap, _fill_pct_now)
            alpha_det  = min(1.0, alpha_det * diam_scale)

        if _last > 0:
            ratio = detected_f / _last
            if tracking_mode:
                if ratio < 0.9:
                    detected_f = _last
                elif ratio > 1.4:
                    detected_f = _last * 0.95 + detected_f * 0.05
                elif detected_f > _last:
                    if in_final:
                        alpha = FINAL_TRACKING_RISE_ALPHA
                    elif ratio > 1.3:
                        alpha = TRACKING_EMA_SPIKE_ALPHA
                    elif ratio > 1.15:
                        alpha = TRACKING_EMA_RISE2_ALPHA
                    else:
                        alpha = TRACKING_EMA_RISE1_ALPHA
                    detected_f = _last * (1 - alpha) + detected_f * alpha
                else:
                    detected_f = _last * (1 - TRACKING_EMA_FALL_ALPHA) + detected_f * TRACKING_EMA_FALL_ALPHA
            else:
                if ratio > SPIKE_RATIO_THRESHOLD:
                    detected_f = _last * 0.95 + detected_f * 0.05
                else:
                    detected_f = _last * (1 - alpha_det) + detected_f * alpha_det

        if not tracking_mode and _last > 0 and detected_f > _last:
            max_rise = RATE_LIMIT_FINAL_HZ if in_final else RATE_LIMIT_NORMAL_HZ
            if detected_f - _last > max_rise:
                detected_f = _last + max_rise

        # ── 이론 곡선 가이드 ─────────────────────────────────────────
        if theory_locked and detected_f > 0:
            f_theory = theory_freq(filling_elapsed)
            if f_theory > 0:
                deviation = abs(detected_f - f_theory) / f_theory
                if in_final:
                    g_alpha  = THEORY_GUIDE_ALPHA_FINAL
                    g_margin = THEORY_GUIDE_MARGIN_FINAL
                else:
                    g_alpha  = THEORY_GUIDE_ALPHA
                    g_margin = THEORY_GUIDE_MARGIN
                if deviation <= g_margin:
                    blended = detected_f * (1 - g_alpha) + f_theory * g_alpha
                    with lock:
                        _tf_cap = float(target_freq)
                    if _tf_cap > 0 and not in_final:
                        blended = min(blended, _tf_cap * 1.01)
                    detected_f = blended

        with lock:
            _tf_cap2   = float(target_freq)
            _calib_cap = bool(calibration_done)
        _cap_mult = 1.20 if not _calib_cap else (1.35 if in_final else 1.12)
        if _tf_cap2 > 0 and detected_f > _tf_cap2 * _cap_mult:
            detected_f = _last

        last_tracked_freq = detected_f

        # ── 6단계: freq_buffer → stable_f (표시·그래프 전용) ─────────
        if in_final:
            buf_size = BUF_SIZE_FINAL
        elif filling_elapsed < EARLY_NOISE_SEC:
            buf_size = EARLY_BUF_SIZE
        else:
            buf_size = 5

        freq_buffer.append(detected_f)
        while len(freq_buffer) > buf_size:
            freq_buffer.popleft()

        cur_median = float(np.median(list(freq_buffer)))
        if cur_median == _prev_buf_median:
            _freeze_count += 1
        else:
            _freeze_count = 0
        _prev_buf_median = cur_median
        if _freeze_count >= FREEZE_RESET_N:
            freq_buffer.clear()
            _freeze_count = 0

        if tracking_mode:
            stable_f = float(np.median(list(freq_buffer)[-BUF_SIZE_FINAL:])) \
                       if len(freq_buffer) >= BUF_SIZE_FINAL else detected_f
        else:
            stable_f = float(np.median(list(freq_buffer))) if freq_buffer else detected_f

        if _init > 0 and stable_f < _init * 0.97:
            stable_f = _init * 0.97
        elif filling_elapsed < EARLY_NOISE_SEC and _last_s > 0:
            if stable_f < _last_s * MONO_DROP_RATIO:
                stable_f = _last_s

        with lock:
            history_time.append(filling_elapsed)
            history_freq.append(stable_f)
            history_detected_freq.append(raw_f_for_reg)
            history_stop_freq.append(f_for_stop_plot)
            last_stable_f   = stable_f
            last_detected_f = raw_f_for_reg
            last_f_for_stop = f_for_stop_plot
            if (not track_on
                    and filling_elapsed > SPLASH_GUARD_TIME
                    and initial_stable_freq == 0
                    and stable_f > INIT_STABLE_MIN_HZ):
                init_stable_buffer.append(stable_f)
                if len(init_stable_buffer) >= 10:
                    initial_stable_freq = float(np.percentile(list(init_stable_buffer), 85))
                    initial_stable_time = float(filling_elapsed)
                    print(f'\n[★ 초기주파수 확정] {initial_stable_freq:.0f}Hz | t={initial_stable_time:.1f}s')
            # [v5.40-TRACK] 트랙 직선을 INIT_REF_TIME(6.85s)에서 읽어 초기 주파수 확정(기존 H 보정값 기준 시각과 동일)
            #   + 그 전까지 트랙에 채택된 데이터를 D 회귀 버퍼에 바로 넣는다.
            if (track_on and _track.active
                    and initial_stable_freq == 0
                    and filling_elapsed >= INIT_REF_TIME):
                l_ref = _track.predict(INIT_REF_TIME)
                if l_ref > 0:
                    initial_stable_freq = float(SOUND_SPEED / (4.0 * l_ref))
                    initial_stable_time = float(INIT_REF_TIME)
                    n_fill = 0
                    for t_h, f_h in _track.hist:
                        if t_h >= WATER_SETTLE_SEC and f_h > 0:
                            reg_time_buffer.append(float(t_h))
                            reg_inv_freq_buffer.append(1.0 / float(f_h))
                            n_fill += 1
                    if len(reg_time_buffer) > REG_MIN_POINTS:
                        _reg_event.set()
                    print(f'\n[★ 초기주파수 확정(트랙)] {initial_stable_freq:.0f}Hz @t={INIT_REF_TIME:.2f}s'
                          f' | 트랙 데이터 {n_fill}점을 D 회귀에 추가 | 현재 t={filling_elapsed:.1f}s')

        # ── [v5.30-PKFLOOR] spike 시 max_freq_seen 갱신 차단 ─────────
        with lock:
            if filling_elapsed > SPLASH_GUARD_TIME and stable_f > max_freq_seen and not _is_spike:
                max_freq_seen = stable_f
            _max_f_seen = float(max_freq_seen)

        with lock:
            _tf_now = float(target_freq)
        if not tracking_mode and _tf_now > 0 and _max_f_seen > _tf_now * 0.75:
            hard_floor = min(_max_f_seen * 0.88, _tf_now * 0.98)
            if stable_f < hard_floor:
                stable_f = hard_floor

        # ── [v5.30-PKFLOOR] spike 시 peak_lock_floor 갱신 차단 ───────
        if stable_f > peak_lock_floor and not _is_spike:
            peak_lock_floor = stable_f
        if peak_lock_floor > 0 and stable_f < peak_lock_floor * 0.90:
            stable_f = peak_lock_floor * 0.90

        # ── 7단계: tracking 모드 진입 판정 ──────────────────────────
        _tracking_thresh = max(TRACKING_ENTRY_HZ, _init * TRACKING_ENTRY_MULT) \
                           if _init > 0 else TRACKING_ENTRY_HZ

        if stable_f > _tracking_thresh:
            tracking_mode_hits += 1
        else:
            tracking_mode_hits = max(0, tracking_mode_hits - 2)

        if tracking_mode_hits >= TRACKING_MODE_THRESHOLD and not tracking_mode:
            with lock:
                tracking_mode = True
            print(f'\n[★ 트래킹 모드] {stable_f:.0f}Hz (thresh={_tracking_thresh:.0f}Hz) 시작')

        # ── 8단계: 회귀 버퍼 수집 (SPIKE-UNI 적용) ──────────────────
        with lock:
            _init_f   = float(initial_stable_freq)
            _cur_d    = float(current_diameter)
            _cand_cnt = len(diameter_candidates)
            _diam_full = (_cand_cnt >= DIAM_CAND_MAXLEN) or \
                         (_cand_cnt >= DIAM_CAND_MIN and filling_elapsed > DIAM_CALC_END_TIME)

        if filling_elapsed > CALC_START_TIME and not _diam_full and not (track_on and _track.coasting):
            if int(filling_elapsed) % 3 == 0 and abs(filling_elapsed - round(filling_elapsed)) < 0.15:
                with lock:
                    _reg_buf_len   = len(reg_time_buffer)
                    _spike_blocked = int(spike_blocked_count)
                print(
                    f'\n[D진단] t={filling_elapsed:.1f}s'
                    f' | init_f={_init_f:.0f}Hz'
                    f' | raw_f={raw_f_for_reg:.0f}Hz'
                    f' | reg_buf={_reg_buf_len}'
                    f' | spikes={_spike_blocked}'
                    f' | D={_cur_d:.2f}cm'
                    f' | cand={_cand_cnt}/{DIAM_CAND_MAXLEN}'
                )

            if _init_f > 0 and raw_f_for_reg > _init_f * 1.005 and raw_f_for_reg < _init_f * 4.0:
                current_inv = 1.0 / raw_f_for_reg
                with lock:
                    _buf_snapshot = list(reg_inv_freq_buffer)

                eff_gate = REG_SPIKE_GATE_EARLY if filling_elapsed < SPIKE_EARLY_TIME else REG_SPIKE_GATE
                if len(_buf_snapshot) >= 5:
                    recent_median = float(np.median(_buf_snapshot[-5:]))
                    spike = (current_inv - recent_median) / (recent_median + 1e-12) > eff_gate
                else:
                    spike = False

                if not spike:
                    with lock:
                        reg_time_buffer.append(filling_elapsed)
                        reg_inv_freq_buffer.append(current_inv)
                        _reg_len_now = len(reg_time_buffer)
                    if _reg_len_now > REG_MIN_POINTS:
                        _reg_event.set()
                else:
                    with lock:
                        spike_blocked_count += 1
            else:
                if int(filling_elapsed) % 3 == 0 and abs(filling_elapsed - round(filling_elapsed)) < 0.15:
                    if _init_f == 0:
                        print(f'\n[D진단] ❌ initial_stable_freq 아직 0')
                    elif raw_f_for_reg <= _init_f * 1.005:
                        print(f'\n[D진단] ❌ raw_f({raw_f_for_reg:.0f}) ≤ init_f({_init_f:.0f})*1.005')
                    elif raw_f_for_reg >= _init_f * 4.0:
                        print(f'\n[D진단] ⚠ raw_f({raw_f_for_reg:.0f}) ≥ init_f({_init_f:.0f})*4.0 → 배음 의심, 제외')

        # ── 9단계: 정지 판단 [v5.30-STABLE-CTRL] ────────────────────
        with lock:
            _tf2      = float(target_freq)
            _cd       = bool(calibration_done)
            _cur_d2   = float(current_diameter)
            _init_air = float(init_air_len_cm)

        if filling_elapsed > CONTROL_START_TIME and _cd and stable_f > 0:
            # [v5.30-STABLE-CTRL] 제어 주파수 = stable_f (EMA+median)
            # f_for_stop(_f_stop_ema)는 로그/그래프 비교용으로만 유지
            f_for_stop = float(_f_stop_ema) if _f_stop_ema > 0 else stable_f

            with lock:
                last_raw_stop_freq = f_for_stop
                last_decision_freq = stable_f    # 실제 제어 기준 주파수

            # [주의/v5.31] 헤더의 'stable_f 제어' 주석과 달리 실제 제어는 f_for_stop을 사용한다.
            #   동작은 v5.30과 동일하게 유지(변경 금지) — 그래프(검증법 참고)로 어느 신호가
            #   후반부 상승을 가장 잘 따라가는지 확인한 뒤, 한쪽으로 통일할 것.
            current_air = SOUND_SPEED / (4 * f_for_stop) - END_CORRECTION_K * _cur_d2
            with lock:
                last_current_air = float(current_air)

            if _init_air > 0:
                fill_pct = max(0.0, min(100.0, (1.0 - current_air / _init_air) * 100.0))

                # [v5.28-FILL-RATE] 상방향 속도 제한
                with lock:
                    _prev_fill = float(last_fill_pct)
                if _prev_fill > 0 and fill_pct > _prev_fill + FILL_PCT_RATE_LIMIT:
                    fill_pct = _prev_fill + FILL_PCT_RATE_LIMIT

                acoustic_fill_pct = fill_pct

                with lock:
                    last_fill_pct          = fill_pct
                    last_decision_fill_pct = fill_pct
                    last_model_valid       = True
                    last_reject_reason     = 'ok'

                # ── [v5.31-STAG-LOG] 후반부 정체 진단 (제어에 영향 없음, 로그 전용) ──
                # 최근 ~약 40청크 동안의 raw / stable_f / f_for_stop 변화율(Hz/s)을 계산.
                # stable_f가 사실상 안 오르는데(<10Hz/s) 목표까지 5%+ 남았으면 정체로 판단하고,
                # raw도 안 오르면 '검출단계', raw는 오르는데 stable만 평평하면 '후처리' 문제.
                _stag_buffer.append((filling_elapsed, raw_f_for_reg, stable_f, f_for_stop))
                if (current_time - _stag_last_log >= 1.0          # 1초에 한 번만 출력
                        and len(_stag_buffer) >= 10               # 표본 충분
                        and fill_pct < TARGET_FILL_PCT - 5.0):     # 아직 목표까지 5%+ 남음
                    _arr = list(_stag_buffer)
                    _dt  = max(_arr[-1][0] - _arr[0][0], 1e-6)     # 0 나눗셈 방지
                    _d_raw  = (_arr[-1][1] - _arr[0][1]) / _dt     # raw 검출 변화율
                    _d_smo  = (_arr[-1][2] - _arr[0][2]) / _dt     # stable_f 변화율
                    _d_stop = (_arr[-1][3] - _arr[0][3]) / _dt     # f_for_stop 변화율
                    if abs(_d_smo) < 10.0:                          # stable_f 정체
                        _src = '검출단계(LPC/FFT)' if abs(_d_raw) < 10.0 else '후처리(median/EMA)'
                        print(f'\n[정체감지] t={filling_elapsed:.1f}s 추정원인={_src}'
                              f' | d_raw={_d_raw:+.0f} d_smo={_d_smo:+.0f} d_stop={_d_stop:+.0f} Hz/s'
                              f' | fill={fill_pct:.0f}%/{TARGET_FILL_PCT:.0f}%')
                    _stag_last_log = current_time

                # ── [v5.32-TIME-Q-BRIDGE] 70% 이후 시간/유량 예측 브릿지 ──
                # 250mL 비커처럼 후반부 공기층이 너무 짧아져 주파수 검출이 포화되는 경우,
                # 70%까지는 음향 추정값을 믿고, 이후는 Q·D·H 기반 시간 외삽으로 채움률을 증가시킨다.
                bridge_used = False
                if (BRIDGE_ENABLE
                        and TARGET_FILL_PCT >= BRIDGE_TARGET_MIN_PCT
                        and _init_air > 0
                        and _cur_d2 > 0
                        and (fill_pct >= BRIDGE_ARM_PCT or bridge_active)):
                    with lock:
                        _bridge_active = bool(bridge_active)
                        _bridge_t0     = float(bridge_start_elapsed)
                        _bridge_p0     = float(bridge_start_fill_pct)
                        _bridge_q      = float(bridge_start_q)

                    if not _bridge_active:
                        # FLOW_RATE 기준을 최소 예측 유량으로 둔다.
                        # 예측 유량을 크게 잡을수록 목표 도달 시점을 더 이르게 판단하므로 넘침 방지에 유리하다.
                        q_for_bridge = max(DYNAMIC_Q_MIN, float(dynamic_Q), FLOW_RATE * BRIDGE_Q_SCALE)
                        target_for_eta = max(BRIDGE_ARM_PCT, TARGET_FILL_PCT - BRIDGE_STOP_ADVANCE_PCT)
                        remain_pct = max(0.0, target_for_eta - fill_pct)
                        area_cm2 = np.pi * (_cur_d2 * 0.5) ** 2
                        eta_sec = (area_cm2 * _init_air * (remain_pct / 100.0)) / (q_for_bridge + 1e-12)

                        with lock:
                            bridge_active         = True
                            bridge_start_elapsed  = filling_elapsed
                            bridge_start_fill_pct = fill_pct
                            bridge_pred_fill_pct  = fill_pct
                            bridge_start_q        = q_for_bridge
                            bridge_start_freq     = f_for_stop
                            bridge_eta_sec        = eta_sec
                            bridge_last_log       = current_time
                            last_control_profile  = 'time_q_bridge'

                        _bridge_active = True
                        _bridge_t0     = filling_elapsed
                        _bridge_p0     = fill_pct
                        _bridge_q      = q_for_bridge

                        print(f'\n[브릿지 시작] t={filling_elapsed:.1f}s'
                              f' | 기준수위={fill_pct:.1f}%'
                              f' | 목표={TARGET_FILL_PCT:.1f}%'
                              f' | D={_cur_d2:.2f}cm H={_init_air:.2f}cm'
                              f' | Q예측={q_for_bridge:.1f}ml/s'
                              f' | ETA≈{eta_sec:.1f}s')

                    if _bridge_active:
                        dt_bridge = max(0.0, filling_elapsed - _bridge_t0)
                        pred_delta_pct = _flow_volume_to_fill_pct(_bridge_q, dt_bridge, _cur_d2, _init_air)
                        pred_fill_pct = max(fill_pct, min(100.0, _bridge_p0 + pred_delta_pct))

                        fill_pct = pred_fill_pct
                        current_air = max(0.0, _init_air * (1.0 - fill_pct / 100.0))
                        bridge_used = True

                        with lock:
                            bridge_pred_fill_pct  = pred_fill_pct
                            last_fill_pct         = fill_pct
                            last_decision_fill_pct = fill_pct
                            last_current_air      = current_air
                            last_control_profile  = 'time_q_bridge'
                            _bridge_last_log_now  = float(bridge_last_log)

                        if current_time - _bridge_last_log_now >= BRIDGE_LOG_INTERVAL:
                            print(f'\n[브릿지 제어] t={filling_elapsed:.1f}s'
                                  f' | pred={pred_fill_pct:.1f}%/{TARGET_FILL_PCT:.1f}%'
                                  f' | acoustic={acoustic_fill_pct:.1f}%'
                                  f' | Q={_bridge_q:.1f}ml/s')
                            with lock:
                                bridge_last_log = current_time
                else:
                    with lock:
                        if not bridge_active:
                            last_control_profile = 'freq_tracking'

                zone_adv      = _get_zone_advance()
                bridge_adv    = BRIDGE_STOP_ADVANCE_PCT if bridge_used else 0.0
                total_advance = STOP_ADVANCE_PCT + zone_adv + bridge_adv
                trigger       = (fill_pct >= TARGET_FILL_PCT - total_advance)
            else:
                fill_pct      = 0.0
                zone_adv      = 0.0
                total_advance = STOP_ADVANCE_PCT
                trigger       = False
                with lock:
                    last_decision_fill_pct = 0.0
                    last_model_valid       = False
                    last_reject_reason     = 'no_init_air'

            with lock:
                if trigger:
                    consecutive_stop_hits += 1
                elif consecutive_stop_hits > 0:
                    consecutive_stop_hits = max(0, consecutive_stop_hits - 1)
                _hits = int(consecutive_stop_hits)

            if current_time - last_print_time >= PRINT_INTERVAL:
                mode_str   = '[T]' if tracking_mode else '   '
                lock_str   = '[R]' if theory_locked  else '   '
                fin_str    = '[F]' if in_final        else '   '
                bar_len    = min(_hits, STOP_TRIGGER_COUNT)
                bar        = '#' * bar_len + '-' * (STOP_TRIGGER_COUNT - bar_len)
                adv_str    = f' adv:{total_advance:+.0f}%' if zone_adv != 0 else ''
                dscale_now = _get_diam_ema_scale(_cur_d2, fill_pct if _init_air > 0 else 0.0)
                if _init_air > 0:
                    print(
                        f'{mode_str}{lock_str}{fin_str}[제어] D:{_cur_d2:.2f}cm '
                        f'| Level:{fill_pct:.1f}%/{TARGET_FILL_PCT:.1f}%{adv_str} '
                        f'| α:{alpha_det:.2f}×{dscale_now:.2f} '
                        f'| smo:{stable_f:.0f}Hz ema:{f_for_stop:.0f}Hz [{bar}]',
                        end='\r'
                    )
                else:
                    print(
                        f'{mode_str}{lock_str}{fin_str}[제어] D:{_cur_d2:.2f}cm '
                        f'| L:{current_air:.2f}cm (측정중) '
                        f'| α:{alpha_det:.2f}×{dscale_now:.2f} '
                        f'| smo:{stable_f:.0f}Hz ema:{f_for_stop:.0f}Hz [{bar}]',
                        end='\r'
                    )
                last_print_time = current_time

            if _hits >= STOP_TRIGGER_COUNT:
                print(f'\n[완료] 목표 도달! D:{_cur_d2:.4f}cm'
                      f' | Level:{fill_pct:.1f}%'
                      f' | adv:{total_advance:+.0f}%'
                      f' | smo:{stable_f:.0f}Hz ema:{f_for_stop:.0f}Hz'
                      f' | L:{current_air:.2f}cm')
                solenoid_off_async()
                with lock:
                    history_freq_snapshot = list(history_freq)
                    last_stop_elapsed_sec = filling_elapsed
                    is_filling     = False
                    request_finish = True
                close_audio_stream_async(delay_sec=0.35)        # 자동 정지 후 분석용 오디오 스트림을 확실히 해제
                return

    except Exception as e:
        print(f'\n[AUDIO_CALLBACK_ERROR] {type(e).__name__}: {e}', flush=True)
        return


# ════════════════════════════════════════════════════════════════════
#  오디오 스트림 관리
# ════════════════════════════════════════════════════════════════════
def audio_callback_timed(indata, frames, time_info, status):
    """
    [CB-DIAG] audio_callback 호출 간격/처리 시간을 측정하는 얇은 래퍼.
    본체(audio_callback)는 전혀 수정하지 않는다. 계측이 꺼져 있으면 곧장 본체만 호출한다.
    측정값은 약 CB_DIAG_INTERVAL초마다 콘솔에 한 줄로 출력한다.
    GIL 영향 판정:
      - gap_max ≫ CB_EXPECTED_MS  → 콜백이 늦게 호출됨(다른 스레드가 GIL 점유)
      - proc_max ≫ cpu_max        → 처리 도중에도 GIL을 뺏김
    """
    global _cb_prev_entry_t, _cb_gap_max_ms, _cb_gap_sum_ms
    global _cb_proc_max_ms, _cb_cpu_max_ms, _cb_count, _cb_late_count, _cb_last_log_t

    if not CB_DIAG_ENABLE:
        return audio_callback(indata, frames, time_info, status)

    entry_t   = time.time()
    cpu_start = time.thread_time()

    # 직전 진입과의 간격(호출이 밀렸는지)
    if _cb_prev_entry_t is not None:
        gap_ms = (entry_t - _cb_prev_entry_t) * 1000.0
        _cb_gap_sum_ms += gap_ms
        _cb_count += 1
        if gap_ms > _cb_gap_max_ms:
            _cb_gap_max_ms = gap_ms
        if gap_ms > CB_EXPECTED_MS * 1.5:
            _cb_late_count += 1
    _cb_prev_entry_t = entry_t

    try:
        return audio_callback(indata, frames, time_info, status)
    finally:
        proc_ms = (time.time() - entry_t) * 1000.0
        cpu_ms  = (time.thread_time() - cpu_start) * 1000.0
        if proc_ms > _cb_proc_max_ms:
            _cb_proc_max_ms = proc_ms
        if cpu_ms > _cb_cpu_max_ms:
            _cb_cpu_max_ms = cpu_ms

        # 급수 중일 때만, 약 CB_DIAG_INTERVAL초마다 요약 출력 후 윈도 리셋
        if is_filling and (entry_t - _cb_last_log_t >= CB_DIAG_INTERVAL) and _cb_count > 0:
            gap_avg = _cb_gap_sum_ms / max(1, _cb_count)
            print(f'\n[CB-DIAG] filling=True | n={_cb_count}'
                  f' | expect={CB_EXPECTED_MS:.0f}ms'
                  f' | gap_avg={gap_avg:.0f} gap_max={_cb_gap_max_ms:.0f}'
                  f' | proc_max={_cb_proc_max_ms:.0f} cpu_max={_cb_cpu_max_ms:.0f}'
                  f' | late={_cb_late_count}/{_cb_count}')
            _cb_last_log_t  = entry_t
            _cb_gap_max_ms  = 0.0
            _cb_gap_sum_ms  = 0.0
            _cb_proc_max_ms = 0.0
            _cb_cpu_max_ms  = 0.0
            _cb_count       = 0
            _cb_late_count  = 0


def ensure_audio_stream():
    global audio_stream
    if audio_stream is not None:
        return
    audio_stream = sd.InputStream(
        device=INPUT_DEVICE,
        callback=audio_callback_timed,   # [CB-DIAG] 계측 래퍼 등록(본체 audio_callback은 그대로)
        channels=1,
        samplerate=SAMPLE_RATE,
        blocksize=CHUNK_SIZE,
    )
    audio_stream.start()

def close_audio_stream_async(delay_sec=0.35):
    """급수 종료 후 급수 분석용 sounddevice 스트림을 비동기로 정리한다."""
    global audio_stream

    stream_ref = audio_stream                                      # 현재 스트림 참조를 고정
    if stream_ref is None:                                         # 열린 분석 스트림이 없으면 종료
        return

    def _worker():
        global audio_stream
        time.sleep(max(0.0, float(delay_sec)))                     # 콜백 종료 여유 시간
        try:
            with lock:
                still_filling = bool(is_filling)                  # 새 급수가 시작됐는지 확인
            if still_filling:
                return                                             # 급수 중이면 닫지 않음
            if audio_stream is not stream_ref:
                return                                             # 다른 스트림으로 바뀌었으면 보호
            try:
                stream_ref.stop()                                  # PortAudio 스트림 정지
            except Exception:
                pass
            try:
                stream_ref.close()                                 # 오디오 장치 해제
            except Exception:
                pass
            audio_stream = None                                    # 다음 급수 때 새로 열도록 초기화
            print('\n[CORE] 급수 분석 audio_stream 정리 완료')
        except Exception as e:
            print(f'\n[CORE] audio_stream 정리 오류: {e}')

    threading.Thread(target=_worker, daemon=True).start()           # GUI/오디오 콜백을 막지 않음
