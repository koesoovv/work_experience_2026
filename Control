TRACK_ACCEL_NOISE       = 0.02   # 칼만: 기울기 변화(테이퍼 컵) 허용 정도(cm²/s³)
TRACK_GATE_SIGMA        = 3.0    # 칼만: 채택 게이트 = 3σ(예측 불확실성 + 측정 잡음)
TRACK_GATE_MIN_REL      = 0.02   # 채택 게이트 최소 폭(ℓ의 2%)
TRACK_GATE_MAX_REL      = 0.10   # 채택 게이트 최대 폭(ℓ의 10%)
TRACK_RATE_WINDOW       = 20     # 추적 채택률을 보는 최근 청크 수
TRACK_MIN_ACCEPT_RATE   = 0.5    # 최근 채택률이 이보다 낮으면 가짜 트랙으로 보고 재탐색(진짜 트랙은 시뮬레이션 90%+)
TRACK_BOOT_WINDOW_SEC   = 2.0    # 트랙 탐색에 쓰는 최근 후보 구간(s)
TRACK_MIN_SPAN_SEC      = 1.0    # 트랙 확정에 필요한 최소 시간 폭(s)
TRACK_MIN_PAIR_DT       = 0.3    # 직선 후보를 만들 두 점의 최소 시간 간격(s)
TRACK_MIN_INLIER_CHUNKS = 10     # 트랙 확정에 필요한 최소 청크 수
TRACK_MIN_COVERAGE      = 0.7    # 탐색 구간 청크 중 직선에 맞는 비율 하한(실제 공명은 대부분 청크에 존재)
